# Supabase Configuration
PUBLIC_SUPABASE_URL=https://xlbxjeieoznucclltjco.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# BenixCS AI Chatbot Widget Token
# Dapatkan token dari dashboard BenixCS: https://benixai.web.id
PUBLIC_BENIX_CS_TOKEN=your_benix_cs_widget_token_here

# (Opsional) Google reCAPTCHA v3 Site Key untuk proteksi bot tak terlihat
# https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
