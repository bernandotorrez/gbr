---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import VisitorTracker from '../components/islands/VisitorTracker';

const SITE_URL = 'https://grandbedahanresidence.com';
const DEFAULT_OG_IMAGE = `${SITE_URL}/assets/banner.webp`;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
}

const { 
  title, 
  description = "Grand Bedahan Residence — Perumahan modern bebas banjir di Sawangan, Depok. Legalitas SHM, DP 0%, KPR bank, lingkungan asri, one gate system. Mulai dari harga terjangkau.",
  ogImage = DEFAULT_OG_IMAGE,
  canonicalUrl,
  ogType = 'website',
} = Astro.props;

const pageTitle = `${title} | Grand Bedahan Residence`;
const canonical = canonicalUrl ?? `${SITE_URL}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Grand Bedahan Residence" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Grand Bedahan Residence`} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${title} — Grand Bedahan Residence`} />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#047857" />

    <!-- generator meta dihapus untuk mencegah version disclosure -->
    
    <!-- Vercel Web Analytics -->
    <Analytics />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Slot for per-page JSON-LD schemas -->
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen font-sans">
    <Navbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- BenixCS AI Chatbot Widget -->
    <!-- SRI hash memastikan script tidak dimanipulasi jika CDN dikompromis -->
    <script 
      is:inline 
      src="https://benixai.web.id/benix-cs-widget.js"
      integrity="sha384-C48jwvNytIzRCcwxhYlfx3pRUNvboJYYavdRQmCpsJlJHshAlFE8qRCQoxqfbHUW"
      crossorigin="anonymous"
    ></script>
    <script is:inline define:vars={{ token: import.meta.env.PUBLIC_BENIX_CS_TOKEN }}>
      if (typeof BenixCSWidget !== 'undefined' && token) {
        BenixCSWidget.init({
          token: token,
          position: 'bottom-right',
          primaryColor: '#14b8a6'
        });
      }
    </script>
    <style is:global>
      /* Align BenixCS widget with FloatingWhatsApp button */
      #benix-cs-widget-container {
        right: 88px !important;
        bottom: 24px !important;
      }
    </style>
    <!-- Internal Visitor & Conversion Tracker -->
    <VisitorTracker client:load />
  </body>
</html>
