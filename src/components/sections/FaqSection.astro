---
import { HelpCircle, Plus } from "lucide-react";

const faqs = [
  {
    pertanyaan: "Di mana lokasi perumahan Grand Bedahan Residence?",
    jawaban:
      "Grand Bedahan Residence beralamat di Jl. Masjid Al-Mukhlisin No.006, Bedahan, Kec. Sawangan, Kota Depok. Lokasinya sangat strategis di kawasan perumahan Sawangan Depok yang bebas banjir, hanya 5 menit ke Halte Busway Sawangan (direct MRT Lebak Bulus), 10 menit ke Mall The Park Sawangan, dan 15 menit ke Stasiun Citayam.",
  },
  {
    pertanyaan: "Apakah sudah sertifikat SHM semua unit?",
    jawaban:
      "Ya, seluruh unit di Grand Bedahan Residence sudah memiliki legalitas lengkap berupa Sertifikat Hak Milik (SHM) dan Izin Mendirikan Bangunan (IMB/PBG) yang sudah pecah per kavling, sehingga aman untuk investasi jangka panjang maupun kepemilikan pribadi.",
  },
  {
    pertanyaan: "Mengapa memilih perumahan di Sawangan Depok di Grand Bedahan Residence?",
    jawaban:
      "Grand Bedahan Residence merupakan pilihan perumahan di Sawangan Depok terbaik karena menggabungkan konsep hunian modern minimalis, lingkungan hijau asri bebas banjir, sistem keamanan One Gate 24 jam dengan CCTV, serta skema pembayaran ringan seperti DP 0% dan bebas biaya BPHTB/AJB/BBN.",
  },
  {
    pertanyaan: "Bagaimana cara pembayaran?",
    jawaban:
      "Kami menyediakan berbagai skema pembayaran yang fleksibel: Cash Keras (dengan diskon khusus), Cash Bertahap (hingga 12-24 bulan), dan KPR Bank rekanan (BCA, BTN, Mandiri, BSI, dll) dengan suku bunga promo menarik.",
  },
  {
    pertanyaan: "Apakah bisa pengajuan KPR?",
    jawaban:
      "Bisa. Tim kami siap mendampingi dan memfasilitasi seluruh proses pengajuan KPR bank rekanan mulai dari kelengkapan berkas hingga disetujui (ACC).",
  },
  {
    pertanyaan: "Apakah ada biaya tambahan di luar harga rumah?",
    jawaban:
      "Selama periode promo berlangsung, seluruh biaya BPHTB, AJB, BBN (Balik Nama), dan biaya surat-surat legalitas lainnya sudah GRATIS dan ditanggung oleh developer.",
  },
  {
    pertanyaan: "Bagaimana cara booking unit dan survei lokasi?",
    jawaban:
      "Booking fee sebesar Rp 3.000.000 (mengurangi harga jual) dapat dibayarkan saat survei lokasi untuk mengunci unit kavling dan promo khusus yang Anda pilih.",
  },
  {
    pertanyaan: "Sejak kapan proyek Grand Bedahan Residence mulai dikembangkan?",
    jawaban:
      "Proyek Grand Bedahan Residence resmi dimulai sejak 2 September 2022 dengan komitmen menghadirkan perumahan berkualitas premium di kawasan Sawangan, Depok.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.pertanyaan,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.jawaban,
    },
  })),
};
---

<section id="faq" class="py-20 bg-[#FAF9F6] scroll-mt-20">
  <!-- JSON-LD FAQPage Schema for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      <!-- Left Column: Interior Living Room Image (5 Cols) -->
      <div class="lg:col-span-5 mb-10 lg:mb-0">
        <div
          class="relative w-full h-[400px] sm:h-[500px] rounded-3xl overflow-hidden shadow-xl border border-gray-200"
        >
          <img
            src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1000&q=80"
            alt="Interior Mewah Grand Bedahan Residence"
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>

      <!-- Right Column: FAQ Accordion (7 Cols) -->
      <div class="lg:col-span-7">
        <div
          class="inline-flex items-center text-sm font-bold text-gray-500 uppercase tracking-wider mb-2"
        >
          <HelpCircle className="w-4 h-4 mr-2 text-gray-400" />
          PERTANYAAN YANG SERING DITANYAKAN
        </div>
        <h2
          class="text-3xl sm:text-4xl font-bold tracking-tight text-[#17201C] font-serif mb-8"
        >
          Frequently Asked Questions
        </h2>

        <div class="space-y-3.5">
          {
            faqs.map((faq, index) => (
              <details class="group bg-white rounded-xl border border-gray-200 shadow-xs overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all">
                <summary class="flex items-center justify-between cursor-pointer px-6 py-4.5 focus:outline-none select-none">
                  <h3 class="text-base sm:text-lg font-bold text-[#17201C] pr-4">
                    {faq.pertanyaan}
                  </h3>
                  <Plus className="w-5 h-5 ml-2 flex-shrink-0 text-gray-400 group-open:rotate-45 group-open:text-[#0E3B2E] transition-transform duration-200" />
                </summary>
                <div class="px-6 pb-6 pt-1 text-sm sm:text-base text-[#374151] leading-relaxed border-t border-gray-100">
                  <p>{faq.jawaban}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
