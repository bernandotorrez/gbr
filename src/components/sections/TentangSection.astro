---
import { Calendar, ShieldCheck, Sparkles, Home, Trees, Award, CheckCircle2, ArrowRight } from 'lucide-react';
---

<section id="tentang" class="py-20 sm:py-24 bg-[#FAF9F6] relative overflow-hidden scroll-mt-20 border-b border-gray-200/60">
  <!-- Subtle decorative ambient background elements -->
  <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-emerald-100/40 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-96 h-96 rounded-full bg-[#E5C695]/15 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Section Header -->
    <div class="max-w-3xl mb-14 lg:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-[#0E3B2E] text-xs sm:text-sm font-bold uppercase tracking-wider mb-3.5 shadow-xs">
        <Sparkles className="w-4 h-4 text-[#E5C695]" />
        <span>REKAM JEJAK & DEDIKASI KAMI</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#17201C] font-serif leading-[1.2]">
        Membangun Impian & Harmoni Keluarga <br class="hidden sm:inline" />
        <span class="text-[#0E3B2E]">Sejak 2 September 2022</span>
      </h2>
      
      <p class="text-base sm:text-lg text-[#4A5568] mt-4 leading-relaxed font-sans">
        Perjalanan Grand Bedahan Residence berawal dari satu visi tulus: menghadirkan kawasan hunian premium yang memadukan keanggunan arsitektur modern dengan kesejukan asri alam Sawangan, Depok.
      </p>
    </div>

    <!-- Main Content Grid: Story Showcase + Key Milestone Pillars -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch mb-16">
      
      <!-- Left Column: Story Highlight Card with Luxury Feel (5 Cols) -->
      <div class="lg:col-span-5 bg-[#07241C] text-white rounded-3xl p-8 sm:p-10 relative overflow-hidden shadow-xl flex flex-col justify-between group">
        <!-- Background subtle glow -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#0E3B2E]/90 via-[#07241C] to-black opacity-95"></div>
        <div class="absolute -bottom-16 -right-16 w-64 h-64 rounded-full bg-[#E5C695]/10 blur-2xl group-hover:scale-110 transition-transform duration-700"></div>

        <div class="relative z-10">
          <!-- Established Date Badge -->
          <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-[#E5C695] text-xs sm:text-sm font-extrabold mb-6">
            <Calendar className="w-4 h-4 text-[#E5C695]" />
            <span>KICKOFF PROYEK • 2 SEPTEMBER 2022</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-bold font-serif leading-tight text-white mb-4">
            Komitmen Nyata, <br />
            Kualitas Tanpa Kompromi
          </h3>

          <p class="text-emerald-100/90 text-sm sm:text-base leading-relaxed mb-6 font-sans">
            Sejak peletakan batu pertama pada <strong class="text-[#E5C695] font-semibold">2 September 2022</strong>, kami berkomitmen menjaga standar tertinggi dalam setiap tahapan pembangunan.
          </p>

          <p class="text-emerald-100/80 text-xs sm:text-sm leading-relaxed mb-6 font-sans">
            Bukan sekadar mendirikan dinding bata, kami merajut setiap sudut perumahan menjadi tempat berlindung yang aman, damai, dan bernilai investasi tinggi yang siap diwariskan lintas generasi.
          </p>
        </div>

        <!-- Trust Badges Row at Bottom of Left Card -->
        <div class="relative z-10 pt-6 border-t border-white/15 grid grid-cols-2 gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#E5C695] shrink-0 border border-white/10">
              <ShieldCheck className="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs text-white/70 font-medium">Legalitas</p>
              <p class="text-sm font-bold text-white">100% SHM</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#E5C695] shrink-0 border border-white/10">
              <Award className="w-5 h-5" />
            </div>
            <div>
              <p class="text-xs text-white/70 font-medium">Kualitas</p>
              <p class="text-sm font-bold text-white">Standar Premium</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: 4 Milestone & Value Cards (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        
        <!-- Card 1: Awal Proyek -->
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-gray-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-[#0E3B2E] mb-4 group-hover:scale-110 transition-transform">
              <Calendar className="w-6 h-6 text-[#0E3B2E]" />
            </div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E3B2E] bg-emerald-50 px-2.5 py-1 rounded-md">
              Awal Pembangunan
            </span>
            <h4 class="text-lg sm:text-xl font-bold text-[#17201C] font-serif mt-3 mb-2">
              2 September 2022
            </h4>
            <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed">
              Titik awal dimulainya pengembangan kawasan terpadu dengan perencanaan tata ruang terstruktur dan fondasi kokoh.
            </p>
          </div>
        </div>

        <!-- Card 2: Legalitas & Sertifikat -->
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-gray-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-100 flex items-center justify-center text-[#B4833E] mb-4 group-hover:scale-110 transition-transform">
              <ShieldCheck className="w-6 h-6 text-[#B4833E]" />
            </div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#B4833E] bg-amber-50 px-2.5 py-1 rounded-md">
              Keamanan Terjamin
            </span>
            <h4 class="text-lg sm:text-xl font-bold text-[#17201C] font-serif mt-3 mb-2">
              Legalitas SHM Pecah
            </h4>
            <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed">
              Sertifikat Hak Milik (SHM) dan IMB/PBG sudah siap per kavling untuk memberikan rasa aman dan kemudahan proses KPR/Cash.
            </p>
          </div>
        </div>

        <!-- Card 3: Konsep Hijau & Asri -->
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-gray-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-[#0E3B2E] mb-4 group-hover:scale-110 transition-transform">
              <Trees className="w-6 h-6 text-[#0E3B2E]" />
            </div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E3B2E] bg-emerald-50 px-2.5 py-1 rounded-md">
              Lingkungan Asri
            </span>
            <h4 class="text-lg sm:text-xl font-bold text-[#17201C] font-serif mt-3 mb-2">
              Harmoni Alami & Bebas Banjir
            </h4>
            <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed">
              Konsep tata ruang hijau dengan resapan optimal yang menjamin kawasan bebas dari banjir dan polusi udara.
            </p>
          </div>
        </div>

        <!-- Card 4: Desain Hunian Modern -->
        <div class="bg-white p-6 sm:p-7 rounded-3xl border border-gray-200/80 shadow-xs hover:shadow-lg transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-[#0E3B2E] mb-4 group-hover:scale-110 transition-transform">
              <Home className="w-6 h-6 text-[#0E3B2E]" />
            </div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#0E3B2E] bg-emerald-50 px-2.5 py-1 rounded-md">
              Arsitektur Elegan
            </span>
            <h4 class="text-lg sm:text-xl font-bold text-[#17201C] font-serif mt-3 mb-2">
              Desain Fungsional & Mewah
            </h4>
            <p class="text-xs sm:text-sm text-[#4A5568] leading-relaxed">
              Plafon tinggi, ventilasi silang optimal, dan pencahayaan alami maksimal untuk kenyamanan dan efisiensi energi hunian.
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Interactive Banner Strip: Rekam Jejak Ringkas -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-emerald-900/10 shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] shrink-0">
          <CheckCircle2 className="w-6 h-6 text-[#0E3B2E]" />
        </div>
        <div>
          <h4 class="text-base sm:text-lg font-bold text-[#17201C] font-serif">
            Siap Menjadi Bagian dari Keluarga Besar Grand Bedahan Residence?
          </h4>
          <p class="text-xs sm:text-sm text-[#4A5568] mt-0.5">
            Konsultasikan kebutuhan hunian Anda dan jadwalkan kunjungan langsung ke lokasi perumahan kami.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
        <a 
          href="/#tipe-rumah" 
          class="flex-1 md:flex-none inline-flex items-center justify-center px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-white bg-[#0E3B2E] hover:bg-[#07241C] shadow-md transition-all group"
        >
          <span>Pilih Tipe Unit</span>
          <ArrowRight className="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1" />
        </a>
        <a 
          href="/#kontak" 
          class="flex-1 md:flex-none inline-flex items-center justify-center px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-[#0E3B2E] bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-all"
        >
          Survei Lokasi
        </a>
      </div>
    </div>

  </div>
</section>
