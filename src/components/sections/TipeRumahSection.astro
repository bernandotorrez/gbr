---
import { formatRupiah } from '../../data/tipeRumah';
import { getTipeRumahList } from '../../lib/api';
import { Bed, Bath, Car, ArrowRight, LayoutGrid, MessageSquare, Store } from 'lucide-react';

const daftarTipeRumah = await getTipeRumahList();
---

<section id="tipe-rumah" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header with Top Tag & Right Link -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <div class="inline-flex items-center text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">
          <LayoutGrid class="w-4 h-4 mr-2 text-gray-400" />
          PILIHAN TERBAIK UNTUK ANDA
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#17201C] font-serif">
          Pilihan Unit Hunian &amp; Komersial
        </h2>
      </div>

      <div class="mt-4 md:mt-0">
        <a 
          href="/tipe-rumah" 
          class="inline-flex items-center text-base font-bold text-[#0E3B2E] hover:text-[#07241C] group"
        >
          <span>Lihat Semua Tipe</span>
          <ArrowRight className="w-4 h-4 ml-1.5 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {daftarTipeRumah.map((tipe) => {
        const isCommercial = 
          tipe.kategori === 'ruko' || 
          tipe.kategori === 'kios' || 
          tipe.slug.includes('ruko') || 
          tipe.slug.includes('kios') || 
          tipe.nama_tipe.toLowerCase().includes('ruko') || 
          tipe.nama_tipe.toLowerCase().includes('kios');

        const waText = encodeURIComponent(
          `Halo Marketing Grand Bedahan Residence, saya tertarik dengan ${tipe.nama_tipe}. Boleh minta info promo, pricelist, dan jadwal survei lokasi?`
        );
        const waUrl = `https://wa.me/6281215776218?text=${waText}`;

        return (
          <div class="bg-white rounded-2xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col group">
            <!-- Card Image with Pill Badge -->
            <div class="relative h-64 sm:h-72 overflow-hidden">
              <img 
                src={tipe.foto_url} 
                alt={tipe.nama_tipe} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              {isCommercial ? (
                <div class="absolute top-4 right-4 bg-[#0E3B2E] text-[#E5C695] border border-[#E5C695]/40 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider shadow-md flex items-center gap-1.5 backdrop-blur-sm">
                  <Store className="w-3.5 h-3.5 text-[#E5C695]" />
                  <span>KIOS &amp; RUANG USAHA</span>
                </div>
              ) : (
                <div class="absolute top-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-1.5 rounded-full text-sm font-bold text-[#17201C] shadow-md">
                  {tipe.nama_tipe}
                </div>
              )}
            </div>
            
            <!-- Card Body -->
            <div class="p-6 sm:p-7 flex flex-col flex-grow">
              <div class="flex items-center gap-2 mb-1">
                <span class={`text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md ${
                  isCommercial ? 'bg-amber-100/80 text-[#B4833E]' : 'bg-emerald-50 text-[#0E3B2E]'
                }`}>
                  {isCommercial ? 'Unit Komersial' : 'Rumah Tinggal'}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-[#17201C] font-serif mb-1 group-hover:text-[#0E3B2E] transition-colors">
                {tipe.nama_tipe}
              </h3>
              <p class="text-2xl sm:text-3xl font-bold text-[#0E3B2E] mb-2 font-sans">
                {formatRupiah(tipe.harga)}
              </p>
              
              {isCommercial ? (
                <p class="text-xs sm:text-sm text-[#595959] mb-4">
                  Luas Kios: <span class="font-bold text-[#17201C]">{tipe.ukuran_bangunan} m²</span> • Dimensi: <span class="font-bold text-[#17201C]">{tipe.dimensi || '4m x 6.2m'}</span>
                </p>
              ) : (
                <p class="text-xs sm:text-sm text-[#595959] mb-4">
                  Luas Tanah: <span class="font-bold text-[#17201C]">{tipe.ukuran_tanah} m²</span> • Luas Bangunan: <span class="font-bold text-[#17201C]">{tipe.ukuran_bangunan} m²</span>
                </p>
              )}
              
              <p class="text-sm text-[#4A5568] mb-6 leading-relaxed line-clamp-2">
                {tipe.deskripsi}
              </p>

              <!-- Specs Row (Dynamic for Commercial vs Residential) -->
              <div class="flex items-center justify-between text-xs sm:text-sm text-[#4A5568] py-3.5 border-y border-gray-100 mb-6 font-semibold bg-[#FAF9F6] px-4 rounded-xl">
                {isCommercial ? (
                  <>
                    <div class="flex items-center gap-1.5">
                      <Store className="w-4 h-4 text-[#B4833E]" />
                      <span>Ruang Usaha</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Bath className="w-4 h-4 text-[#B4833E]" />
                      <span>{tipe.jumlah_kamar_mandi} Toilet</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Car className="w-4 h-4 text-[#B4833E]" />
                      <span>Parkir Luas</span>
                    </div>
                  </>
                ) : (
                  <>
                    <div class="flex items-center gap-1.5">
                      <Bed className="w-4 h-4 text-[#047857]" />
                      <span>{tipe.jumlah_kamar_tidur} K. Tidur</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Bath className="w-4 h-4 text-[#047857]" />
                      <span>{tipe.jumlah_kamar_mandi} K. Mandi</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Car className="w-4 h-4 text-[#047857]" />
                      <span>{tipe.jumlah_carport > 0 ? `${tipe.jumlah_carport} Carport` : 'Tanpa Carport'}</span>
                    </div>
                  </>
                )}
              </div>

              <!-- Action Buttons (Lihat Detail Lengkap & Konsultasi / Survey Lokasi) -->
              <div class="mt-auto space-y-3">
                <a 
                  href={`/tipe-rumah/${tipe.slug}`}
                  class="w-full flex items-center justify-center gap-2 px-6 py-3.5 sm:py-4 rounded-xl font-bold text-base text-white bg-[#0E3B2E] hover:bg-[#07241C] shadow-md hover:shadow-lg transition-all"
                >
                  <span>Lihat Detail Lengkap</span>
                  <ArrowRight className="w-5 h-5" />
                </a>

                <a 
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-base text-[#0E3B2E] bg-emerald-50 hover:bg-emerald-100/90 border border-emerald-200 transition-all shadow-xs"
                >
                  <MessageSquare className="w-4.5 h-4.5 text-[#0E3B2E]" />
                  <span>Konsultasi / Survey Lokasi</span>
                </a>
              </div>

            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

