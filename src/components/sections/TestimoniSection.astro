---
import { Star, MessageSquare } from 'lucide-react';

const testimonis = [
  {
    nama: 'Andi Pratama',
    peran: 'Pembeli',
    isi: 'Lingkungan nyaman, akses mudah, dan pelayanan sangat ramah. Tidak salah memilih Grand Bedahan Residence.',
    rating: 5,
    foto: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80'
  },
  {
    nama: 'Dewi Lestari',
    peran: 'Pembeli',
    isi: 'Desain rumah modern dan kualitas bangunan sangat baik. Keluarga kami merasa betah tinggal di sini.',
    rating: 5,
    foto: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=150&q=80'
  },
  {
    nama: 'Budi Santoso',
    peran: 'Investor',
    isi: 'Lokasi strategis dekat fasilitas umum. Investasi terbaik untuk masa depan keluarga.',
    rating: 5,
    foto: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80'
  }
];
---

<section id="testimoni" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <div class="inline-flex items-center text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">
          <MessageSquare className="w-4 h-4 mr-2 text-gray-400" />
          TESTIMONI
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#17201C] font-serif">
          Apa Kata Mereka?
        </h2>
      </div>

      <div class="mt-4 md:mt-0">
        <a 
          href="#kontak" 
          class="text-base font-bold text-[#0E3B2E] hover:text-[#07241C] transition-colors"
        >
          Lihat Semua Testimoni
        </a>
      </div>
    </div>

    <!-- Testimonial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonis.map((testi) => (
        <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <!-- Star Ratings (Gold/Amber) -->
            <div class="flex items-center gap-1.5 text-[#E5C695] mb-5">
              {[...Array(5)].map(() => (
                <Star className="w-5 h-5 fill-current text-[#E5C695]" />
              ))}
            </div>
            
            <!-- Quote Text -->
            <p class="text-base sm:text-lg text-[#2D3748] leading-relaxed mb-8 font-medium">
              "{testi.isi}"
            </p>
          </div>
          
          <!-- User Profile -->
          <div class="flex items-center pt-5 border-t border-gray-100">
            <img 
              class="w-12 h-12 rounded-full object-cover border border-gray-200 shadow-xs" 
              src={testi.foto} 
              alt={testi.nama} 
            />
            <div class="ml-4">
              <p class="text-base font-bold text-[#17201C] font-sans leading-tight">{testi.nama}</p>
              <p class="text-sm font-semibold text-gray-500 mt-0.5">{testi.peran}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

