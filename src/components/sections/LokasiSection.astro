---
import { Train, ShoppingBag, HeartPulse, GraduationCap, MapPin, Compass, ExternalLink, Bus } from 'lucide-react';
---

<section id="fasilitas" class="py-20 bg-white scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12 items-center">
      
      <!-- Content (Left Column - 6 Cols) -->
      <div class="lg:col-span-5 mb-12 lg:mb-0">
        <div class="inline-flex items-center text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">
          <Compass className="w-4 h-4 mr-2 text-gray-400" />
          LOKASI STRATEGIS
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#17201C] font-serif mb-4">
          Akses Mudah ke Berbagai Fasilitas
        </h2>
        <p class="text-base sm:text-lg text-[#4A5568] mb-8 leading-relaxed">
          Lokasi strategis memudahkan aktivitas sehari-hari Anda dengan dekatnya akses ke berbagai fasilitas penting di sekitar kawasan.
        </p>
        
        <!-- Access Points -->
        <div class="space-y-3.5 mb-8">
          <!-- 1. Halte Busway Sawangan Direct MRT -->
          <div class="flex items-center p-3.5 sm:p-4 rounded-2xl bg-gray-50/80 hover:bg-[#E8F3EE]/60 border border-gray-100/80 transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] flex-shrink-0 shadow-xs">
              <Bus className="w-6 h-6" />
            </div>
            <div class="ml-4">
              <h3 class="text-2xl font-sans font-extrabold text-[#0E3B2E] leading-snug tracking-tight">5 Menit</h3>
              <p class="text-sm sm:text-base text-[#4A5568] font-medium mt-0.5">Ke Halte Busway Sawangan (Direct MRT Lebak Bulus)</p>
            </div>
          </div>

          <!-- 2. Stasiun Citayam -->
          <div class="flex items-center p-3.5 sm:p-4 rounded-2xl bg-gray-50/80 hover:bg-[#E8F3EE]/60 border border-gray-100/80 transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] flex-shrink-0 shadow-xs">
              <Train className="w-6 h-6" />
            </div>
            <div class="ml-4">
              <h3 class="text-2xl font-sans font-extrabold text-[#0E3B2E] leading-snug tracking-tight">15 Menit</h3>
              <p class="text-sm sm:text-base text-[#4A5568] font-medium mt-0.5">Ke Stasiun Citayam</p>
            </div>
          </div>

          <!-- 3. Perbelanjaan -->
          <div class="flex items-center p-3.5 sm:p-4 rounded-2xl bg-gray-50/80 hover:bg-[#E8F3EE]/60 border border-gray-100/80 transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] flex-shrink-0 shadow-xs">
              <ShoppingBag className="w-6 h-6" />
            </div>
            <div class="ml-4">
              <h3 class="text-2xl font-sans font-extrabold text-[#0E3B2E] leading-snug tracking-tight">10 Menit</h3>
              <p class="text-sm sm:text-base text-[#4A5568] font-medium mt-0.5">Ke Pusat Perbelanjaan (The Park Sawangan, Superindo Sawangan)</p>
            </div>
          </div>

          <!-- 4. Rumah Sakit -->
          <div class="flex items-center p-3.5 sm:p-4 rounded-2xl bg-gray-50/80 hover:bg-[#E8F3EE]/60 border border-gray-100/80 transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] flex-shrink-0 shadow-xs">
              <HeartPulse className="w-6 h-6" />
            </div>
            <div class="ml-4">
              <h3 class="text-2xl font-sans font-extrabold text-[#0E3B2E] leading-snug tracking-tight">10 Menit</h3>
              <p class="text-sm sm:text-base text-[#4A5568] font-medium mt-0.5">Ke Fasilitas Kesehatan (RS Permata Depok)</p>
            </div>
          </div>

          <!-- 5. Pendidikan -->
          <div class="flex items-center p-3.5 sm:p-4 rounded-2xl bg-gray-50/80 hover:bg-[#E8F3EE]/60 border border-gray-100/80 transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-[#E8F3EE] flex items-center justify-center text-[#0E3B2E] flex-shrink-0 shadow-xs">
              <GraduationCap className="w-6 h-6" />
            </div>
            <div class="ml-4">
              <h3 class="text-2xl font-sans font-extrabold text-[#0E3B2E] leading-snug tracking-tight">5 Menit</h3>
              <p class="text-sm sm:text-base text-[#4A5568] font-medium mt-0.5">Ke Institusi Pendidikan (SDIT Sabda Alam)</p>
            </div>
          </div>
        </div>

        <!-- Button Lihat Rute di Peta -->
        <div>
          <a 
            href="https://www.google.com/maps/place/Grand+Bedahan+Residence/@-6.4267651,106.7684392,17z/data=!3m1!4b1!4m6!3m5!1s0x2e69e9006c4b7593:0xb85a545d9b9e5a93!8m2!3d-6.4267651!4d106.7710141!16s%2Fg%2F11x65k2kvr?hl=id&entry=ttu&g_ep=EgoyMDI2MDgxOS4wIKXMDSoASAFQAw%3D%3D"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3.5 border border-gray-300 rounded-xl text-base font-bold text-[#17201C] bg-white hover:bg-gray-50 transition-all shadow-sm group"
          >
            <span>Lihat Rute di Peta</span>
            <ExternalLink className="w-4.5 h-4.5 ml-2 text-gray-500 group-hover:text-[#0E3B2E]" />
          </a>
        </div>
      </div>
      
      <!-- Styled Map Container (Right Column - 7 Cols) -->
      <div class="lg:col-span-7 relative">
        <div class="relative w-full h-[450px] sm:h-[500px] rounded-3xl overflow-hidden shadow-lg border border-gray-200 bg-[#EBF2F5]">
          <iframe 
            src="https://maps.google.com/maps?q=-6.4267651,106.7710141&hl=id&z=17&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Lokasi Grand Bedahan Residence"
            class="w-full h-full filter saturate-125"
          ></iframe>

          <!-- Floating Badge Pin on Top of Map (Grand Bedahan Residence) -->
          <div class="absolute top-6 left-6 bg-[#0E3B2E] text-white px-4 py-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-[#165643] backdrop-blur-md">
            <MapPin className="w-5 h-5 text-[#E5C695] flex-shrink-0" />
            <div>
              <p class="text-sm font-bold leading-none">Grand Bedahan Residence</p>
              <p class="text-xs text-emerald-200 mt-1">Sawangan, Depok</p>
            </div>
          </div>

          <!-- Floating Points indicator bottom -->
          <div class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-md px-4 py-2 rounded-xl shadow-md text-sm font-bold text-gray-800 flex items-center gap-2 border border-gray-200">
            <MapPin className="w-4.5 h-4.5 text-[#0E3B2E]" />
            <span>Kawasan Strategis Sawangan</span>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

