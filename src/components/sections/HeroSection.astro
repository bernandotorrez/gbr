---
import { ArrowRight, ChevronDown } from "lucide-react";
---

<section
  id="beranda"
  class="relative min-h-[90vh] lg:min-h-[95vh] flex items-center bg-gray-900 overflow-hidden"
>
  <!-- Full-bleed Dusk Residential Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://xlbxjeieoznucclltjco.supabase.co/storage/v1/object/public/image/banner.webp"
      alt="Grand Bedahan Residence Hunian Asri"
      class="w-full h-full object-cover object-center scale-105 animate-fade-in"
    />
    <!-- Exact Gradient Overlay from reference design -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#07241C]/95 via-[#07241C]/75 to-transparent"
    >
    </div>
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full py-28 lg:py-36"
  >
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Top Pill Badge -->
      <div
        class="inline-flex items-center px-4 py-2 rounded-full bg-black/40 backdrop-blur-md border border-white/25 text-white text-sm font-semibold uppercase tracking-wider mb-6 shadow-sm"
      >
        HUNIAN NYAMAN, INVESTASI AMAN
      </div>

      <!-- Main Headline -->
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white font-serif tracking-tight leading-[1.15] mb-6"
      >
        Hunian Asri & Nyaman di<br />
        <span class="text-white">Pusat Kota Depok</span>
      </h1>

      <!-- Subtitle Description -->
      <p
        class="text-lg sm:text-xl text-emerald-50/95 max-w-xl mb-10 leading-relaxed font-sans"
      >
        Temukan rumah impian dengan desain modern, lingkungan sejuk, dan akses
        strategis untuk kenyamanan Anda dan keluarga tercinta.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/#tipe-rumah"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base sm:text-lg font-bold text-white bg-[#0E3B2E] hover:bg-[#07241C] border border-[#1C6B53] shadow-xl hover:shadow-2xl transition-all group"
        >
          <span>Lihat Rumah</span>
          <ArrowRight
            className="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1"
          />
        </a>

        <a
          href="/#kontak"
          class="inline-flex items-center justify-center px-8 py-4 rounded-full text-base sm:text-lg font-bold text-white border-2 border-white/90 hover:bg-white hover:text-[#0B2E24] transition-all shadow-md"
        >
          Hubungi Kami
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator with Smooth Scroll -->
  <div class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 z-20">
    <a
      href="#tipe-rumah"
      class="flex flex-col items-center gap-2 group cursor-pointer"
      aria-label="Scroll ke Tipe Rumah"
    >
      <span
        class="text-xs font-semibold tracking-widest uppercase text-emerald-100/80 group-hover:text-[#E5C695] transition-colors drop-shadow-sm"
      >
        Scroll ke Bawah
      </span>
      <!-- Mouse Scroll Icon -->
      <div
        class="w-6 h-10 rounded-full border-2 border-white/40 group-hover:border-[#E5C695] flex items-start justify-center p-1.5 transition-colors shadow-lg backdrop-blur-xs bg-black/20"
      >
        <div class="w-1.5 h-2.5 bg-[#E5C695] rounded-full animate-bounce"></div>
      </div>
      <ChevronDown
        className="w-4 h-4 -mt-1 text-white/70 group-hover:text-[#E5C695] animate-pulse"
      />
    </a>
  </div>
</section>
