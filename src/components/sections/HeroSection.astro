---
import {
  ArrowRight,
  ChevronDown,
  ShieldCheck,
  Lock,
  Video,
  FileCheck,
  MapPin,
  CheckCircle2,
  Sparkles,
} from "lucide-react";
---

<section
  id="beranda"
  class="relative md:min-h-screen md:min-h-dvh flex flex-col md:justify-between bg-gray-900 overflow-hidden"
>
  <!-- Full-bleed Video Tour Background -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <video
      id="hero-banner-video"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline="true"
      x5-playsinline="true"
      x5-video-player-type="h5"
      x5-video-player-fullscreen="false"
      x-webkit-airplay="allow"
      disablepictureinpicture="true"
      disableremoteplayback="true"
      controlslist="nodownload nofullscreen noremoteplayback"
      preload="auto"
      poster="https://xlbxjeieoznucclltjco.supabase.co/storage/v1/object/public/image/banner.webp"
      class="w-full h-full object-cover object-center pointer-events-none"
    >
      <source
        src="https://xlbxjeieoznucclltjco.supabase.co/storage/v1/object/public/video/video.mp4"
        type="video/mp4"
      />
    </video>
    <!-- Refined Translucent Gradient Overlay for crystal clear video visibility & text legibility -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#07241C]/70 via-[#07241C]/40 to-transparent"
    >
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/20"></div>
  </div>

  <!-- Universal Cross-Browser Autoplay Engine (Safari, Chrome, Firefox, Edge, Samsung Internet, WebViews) -->
  <script is:inline>
    (function () {
      const video = document.getElementById("hero-banner-video");
      if (!video) return;

      // Force absolute mute & inline attributes across all browser engines
      video.muted = true;
      video.defaultMuted = true;
      video.volume = 0;
      video.playsInline = true;

      const executePlay = () => {
        if (!video.paused) return;
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {
            // Browser blocked zero-gesture autoplay (e.g. Low Power Mode / battery saver)
            // Trigger seamless unlock on the very first user interaction anywhere on the screen
            const interactionEvents = [
              "touchstart",
              "touchend",
              "pointerdown",
              "mousedown",
              "scroll",
              "wheel",
              "keydown"
            ];
            const unlockHandler = () => {
              video.muted = true;
              video.play().catch(() => {});
              interactionEvents.forEach((evt) => {
                window.removeEventListener(evt, unlockHandler, { capture: true });
                document.removeEventListener(evt, unlockHandler, { capture: true });
              });
            };

            interactionEvents.forEach((evt) => {
              window.addEventListener(evt, unlockHandler, { passive: true, once: true, capture: true });
              document.addEventListener(evt, unlockHandler, { passive: true, once: true, capture: true });
            });
          });
        }
      };

      // 1. Trigger immediately
      executePlay();

      // 2. Trigger on DOM Ready & Window Load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", executePlay);
      }
      window.addEventListener("load", executePlay);

      // 3. Trigger on video lifecycle load events
      video.addEventListener("loadedmetadata", executePlay);
      video.addEventListener("loadeddata", executePlay);
      video.addEventListener("canplay", executePlay);
      video.addEventListener("canplaythrough", executePlay);

      // 4. Resume on Tab Switching / Page Visibility
      window.addEventListener("pageshow", executePlay);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") executePlay();
      });

      // 5. Intersection Observer: ensure playback when hero section is on screen
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && video.paused) {
                executePlay();
              }
            });
          },
          { threshold: 0.1 }
        );
        observer.observe(video);
      }
    })();
  </script>

  <!-- Main Hero Content -->
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pt-24 pb-6 sm:pt-28 sm:pb-8 lg:pt-28"
  >
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Top Pill Badge -->
      <div
        class="inline-flex items-center px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/25 text-[#E5C695] text-[11px] sm:text-xs md:text-sm font-semibold uppercase tracking-wider mb-3 sm:mb-4 shadow-sm"
      >
        <Sparkles className="w-3.5 h-3.5 mr-1.5 text-[#E5C695]" />
        <span>CLUSTER EKSKLUSIF • INVESTASI TERBAIK</span>
      </div>

      <!-- Main Headline -->
      <h1
        class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white font-serif tracking-tight leading-[1.2] sm:leading-[1.15] mb-3 sm:mb-4 drop-shadow-lg"
      >
        Hunian Modern, Suasana Asri,<br />
        <span class="text-[#E5C695]">Hidup Lebih Berarti</span>
      </h1>

      <!-- Subtitle Description -->
      <p
        class="text-xs sm:text-base lg:text-lg text-white max-w-xl mb-4 sm:mb-6 leading-relaxed font-sans drop-shadow-md"
      >
        Nikmati keseimbangan sempurna antara kenyamanan modern dan ketenangan alam. Hunian elegan dengan lingkungan hijau dan akses strategis, dirancang untuk menemani setiap momen berharga bersama keluarga.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3.5 mb-5 sm:mb-6">
        <a
          href="/#tipe-rumah"
          class="inline-flex items-center justify-center px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-full text-xs sm:text-sm md:text-base font-bold text-white bg-[#0E3B2E] hover:bg-[#07241C] border border-[#1C6B53] shadow-lg hover:shadow-2xl transition-all group"
        >
          <span>Lihat Rumah</span>
          <ArrowRight
            className="w-4 h-4 sm:w-5 sm:h-5 ml-1.5 sm:ml-2 transition-transform group-hover:translate-x-1"
          />
        </a>

        <a
          href="/#kontak"
          class="inline-flex items-center justify-center px-5 py-2.5 sm:px-7 sm:py-3.5 rounded-full text-xs sm:text-sm md:text-base font-bold text-white border-2 border-white/90 hover:bg-white hover:text-[#0B2E24] transition-all shadow-md"
        >
          Hubungi Kami
        </a>
      </div>

      <!-- Key Features Highlights (6 Key Points in neat frosted micro-cards) -->
      <div class="pt-4 border-t border-white/15 grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-2.5 text-white/90 text-[11px] sm:text-xs md:text-sm font-medium max-w-xl">
        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <Lock className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">One Gate System</span>
        </div>

        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <FileCheck className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">Legalitas SHM</span>
        </div>

        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <ShieldCheck className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">Security 24 Jam</span>
        </div>

        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <MapPin className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">Lokasi Strategis</span>
        </div>

        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <Video className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">CCTV 24/7</span>
        </div>

        <div class="flex items-center gap-2 bg-black/25 backdrop-blur-xs px-2.5 py-1.5 rounded-lg border border-white/10">
          <div class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <CheckCircle2 className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span class="truncate">Bebas Banjir</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator with Smooth Scroll (Centered at bottom) -->
  <div class="relative z-20 pb-4 sm:pb-6 w-full flex flex-col items-center justify-center">
    <a
      href="#tipe-rumah"
      class="flex flex-col items-center gap-1 group cursor-pointer"
      aria-label="Scroll ke Tipe Rumah"
    >
      <span
        class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-emerald-100/80 group-hover:text-[#E5C695] transition-colors drop-shadow-sm"
      >
        Scroll ke Bawah
      </span>
      <!-- Mouse Scroll Icon -->
      <div
        class="w-5 h-7 sm:w-6 sm:h-9 rounded-full border-2 border-white/40 group-hover:border-[#E5C695] flex items-start justify-center p-1 transition-colors shadow-lg backdrop-blur-xs bg-black/20"
      >
        <div class="w-1 h-2 bg-[#E5C695] rounded-full animate-bounce"></div>
      </div>
      <ChevronDown
        className="w-3.5 h-3.5 -mt-0.5 text-white/70 group-hover:text-[#E5C695] animate-pulse"
      />
    </a>
  </div>
</section>
