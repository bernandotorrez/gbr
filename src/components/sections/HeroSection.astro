---
import {
  ArrowRight,
  ChevronDown,
  ShieldCheck,
  Lock,
  Video,
  FileCheck,
  MapPin,
  CheckCircle2,
} from "lucide-react";
---

<section
  id="beranda"
  class="relative min-h-screen min-h-dvh flex items-start sm:items-center bg-gray-900 overflow-hidden"
>
  <!-- Full-bleed Dusk Residential Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://xlbxjeieoznucclltjco.supabase.co/storage/v1/object/public/image/banner.webp"
      alt="Grand Bedahan Residence Hunian Asri"
      class="w-full h-full object-cover object-center scale-105 animate-fade-in"
    />
    <!-- Exact Gradient Overlay from reference design -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#07241C]/95 via-[#07241C]/75 to-transparent"
    >
    </div>
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full pt-28 pb-12 sm:pt-28 sm:pb-16 lg:pt-24 lg:pb-20"
  >
    <div class="max-w-2xl lg:max-w-3xl">
      <!-- Top Pill Badge -->
      <div
        class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-black/40 backdrop-blur-md border border-white/25 text-[#E5C695] text-xs sm:text-sm font-semibold uppercase tracking-wider mb-4 sm:mb-5 shadow-sm"
      >
        ✨ CLUSTER EKSKLUSIF • INVESTASI TERBAIK
      </div>

      <!-- Main Headline -->
      <h1
        class="text-[28px] sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white font-serif tracking-tight leading-[1.2] sm:leading-[1.15] mb-4 sm:mb-5"
      >
        Hunian Modern, Suasana Asri,<br />
        <span class="text-[#E5C695]">Hidup Lebih Berarti</span>
      </h1>

      <!-- Subtitle Description -->
      <p
        class="text-sm sm:text-base lg:text-lg text-emerald-50/95 max-w-xl mb-6 sm:mb-7 leading-relaxed font-sans"
      >
        Nikmati keseimbangan sempurna antara kenyamanan modern dan ketenangan alam. Hunian elegan dengan lingkungan hijau dan akses strategis, dirancang untuk menemani setiap momen berharga bersama keluarga.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-3.5 mb-6 sm:mb-7">
        <a
          href="/#tipe-rumah"
          class="inline-flex items-center justify-center px-6 py-3 sm:px-7 sm:py-3.5 rounded-full text-sm sm:text-base font-bold text-white bg-[#0E3B2E] hover:bg-[#07241C] border border-[#1C6B53] shadow-lg hover:shadow-2xl transition-all group"
        >
          <span>Lihat Rumah</span>
          <ArrowRight
            className="w-4 h-4 sm:w-5 sm:h-5 ml-1.5 sm:ml-2 transition-transform group-hover:translate-x-1"
          />
        </a>

        <a
          href="/#kontak"
          class="inline-flex items-center justify-center px-6 py-3 sm:px-7 sm:py-3.5 rounded-full text-sm sm:text-base font-bold text-white border-2 border-white/90 hover:bg-white hover:text-[#0B2E24] transition-all shadow-md"
        >
          Hubungi Kami
        </a>
      </div>

      <!-- Key Features Highlights (6 Key Points in 2 clean columns) -->
      <div class="pt-4 sm:pt-5 border-t border-white/15 grid grid-cols-2 gap-y-2.5 gap-x-4 sm:gap-x-8 text-white/90 text-xs sm:text-sm font-medium max-w-lg">
        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <Lock className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>One Gate System</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <FileCheck className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>Legalitas SHM</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <ShieldCheck className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>Security 24 Jam</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <MapPin className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>Lokasi Strategis</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <Video className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>CCTV 24/7</span>
        </div>

        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="w-4.5 h-4.5 sm:w-5 sm:h-5 rounded-full bg-[#E5C695]/20 border border-[#E5C695]/40 flex items-center justify-center text-[#E5C695] shrink-0">
            <CheckCircle2 className="w-2.5 h-2.5 sm:w-3 sm:h-3" />
          </div>
          <span>Bebas Banjir</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator with Smooth Scroll -->
  <div class="absolute bottom-3 sm:bottom-5 left-1/2 -translate-x-1/2 z-20 hidden md:block">
    <a
      href="#tipe-rumah"
      class="flex flex-col items-center gap-1.5 group cursor-pointer"
      aria-label="Scroll ke Tipe Rumah"
    >
      <span
        class="text-[10px] sm:text-xs font-semibold tracking-widest uppercase text-emerald-100/80 group-hover:text-[#E5C695] transition-colors drop-shadow-sm"
      >
        Scroll ke Bawah
      </span>
      <!-- Mouse Scroll Icon -->
      <div
        class="w-5 h-8 sm:w-6 sm:h-9 rounded-full border-2 border-white/40 group-hover:border-[#E5C695] flex items-start justify-center p-1 transition-colors shadow-lg backdrop-blur-xs bg-black/20"
      >
        <div class="w-1 h-2 bg-[#E5C695] rounded-full animate-bounce"></div>
      </div>
      <ChevronDown
        className="w-3.5 h-3.5 -mt-1 text-white/70 group-hover:text-[#E5C695] animate-pulse"
      />
    </a>
  </div>
</section>
