---
import { MapPin, Phone, MessageSquare } from 'lucide-react';
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0B281F] text-white pt-16 pb-12 border-t border-[#144739]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-[#164D3E]">
      
      <!-- Col 1: Brand & Socials (4 Cols) -->
      <div class="md:col-span-4">
        <a href="/" class="inline-flex flex-col mb-4 group">
          <span class="text-2xl font-bold text-white tracking-tight leading-none font-serif group-hover:text-[#E5C695] transition-colors">
            Grand Bedahan
          </span>
          <span class="text-xs text-[#E5C695] font-semibold tracking-[0.25em] uppercase mt-1">
            Residence
          </span>
        </a>
        
        <p class="text-xs sm:text-sm text-emerald-100/70 leading-relaxed mb-6 max-w-sm">
          Hunian asri, nyaman dan strategis di pusat kota Bedahan. Investasi aman untuk masa depan Anda.
        </p>

        <!-- Social Icons (Clean Inline SVGs) -->
        <div class="flex items-center gap-3">
          <a href="https://www.instagram.com/grandbedahan.id" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#E5C695] hover:text-[#0B281F] text-white flex items-center justify-center transition-all" aria-label="Instagram">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigasi (2.5 Cols) -->
      <div class="md:col-span-2">
        <h3 class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4">Navigasi</h3>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li><a href="/#beranda" class="hover:text-[#E5C695] transition-colors">Beranda</a></li>
          <li><a href="/#tipe-rumah" class="hover:text-[#E5C695] transition-colors">Tipe Rumah</a></li>
          <li><a href="/#fasilitas" class="hover:text-[#E5C695] transition-colors">Fasilitas</a></li>
          <li><a href="/#virtual-tour" class="hover:text-[#E5C695] transition-colors">Virtual Tour</a></li>
          <li><a href="/#promo" class="hover:text-[#E5C695] transition-colors">Promo</a></li>
          <li><a href="/#artikel" class="hover:text-[#E5C695] transition-colors">Artikel</a></li>
          <li><a href="/#testimoni" class="hover:text-[#E5C695] transition-colors">Testimoni</a></li>
          <li><a href="/#faq" class="hover:text-[#E5C695] transition-colors">FAQ</a></li>
          <li><a href="/#kontak" class="hover:text-[#E5C695] transition-colors">Kontak</a></li>
        </ul>
      </div>

      <!-- Col 3: Tipe Rumah (2.5 Cols) -->
      <div class="md:col-span-2">
        <h3 class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4">Tipe Rumah</h3>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li><a href="/tipe-rumah/tipe-36-72" class="hover:text-[#E5C695] transition-colors">Tipe 36/72</a></li>
          <li><a href="/tipe-rumah/tipe-45-72" class="hover:text-[#E5C695] transition-colors">Tipe 45/72</a></li>
        </ul>
      </div>

      <!-- Col 4: Hubungi Kami (3 Cols) -->
      <div class="md:col-span-4">
        <h3 class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4">Hubungi Kami</h3>
        <ul class="space-y-3.5 text-sm text-emerald-100/80">
          <li class="flex items-start gap-3">
            <MapPin className="w-5 h-5 text-[#E5C695] flex-shrink-0 mt-0.5" />
            <span class="leading-relaxed">Jl. Masjid Al-Mukhlisin No.006, RT.002, Bedahan, Kec. Sawangan, Kota Depok, Jawa Barat 16519</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone className="w-5 h-5 text-[#E5C695] flex-shrink-0" />
            <a href="https://wa.me/6281215776218" target="_blank" rel="noopener noreferrer" class="hover:text-[#E5C695] font-bold text-white transition-colors">
              0812-1577-6218
            </a>
          </li>
          <li class="flex items-center gap-3">
            <MessageSquare className="w-5 h-5 text-[#E5C695] flex-shrink-0" />
            <span>Layanan: 08.00 - 17.00 WIB</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 text-center text-sm text-emerald-100/60 font-medium">
      <p>&copy; {currentYear} Grand Bedahan Residence. All Rights Reserved.</p>
    </div>
  </div>
</footer>
