---
import { MapPin, Phone, MessageSquare } from "lucide-react";
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0B281F] text-white pt-16 pb-12 border-t border-[#144739]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-[#164D3E]"
    >
      <!-- Col 1: Brand & Socials (4 Cols) -->
      <div class="md:col-span-4">
        <a href="/" class="inline-flex flex-col mb-4 group">
          <span
            class="text-2xl font-bold text-white tracking-tight leading-none font-serif group-hover:text-[#E5C695] transition-colors"
          >
            Grand Bedahan
          </span>
          <span
            class="text-xs text-[#E5C695] font-semibold tracking-[0.25em] uppercase mt-1"
          >
            Residence
          </span>
        </a>

        <p
          class="text-xs sm:text-sm text-emerald-100/70 leading-relaxed mb-6 max-w-sm"
        >
          Hunian asri, nyaman, dan strategis di Sawangan, Depok. Dikembangkan dengan penuh dedikasi sejak 2 September 2022 sebagai investasi aman untuk masa depan keluarga Anda.
        </p>

        <!-- Social Icons (Clean Inline SVGs) -->
        <div class="flex items-center gap-3">
          <a
            href="https://www.instagram.com/grandbedahan.id"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#E5C695] hover:text-[#0B281F] text-white flex items-center justify-center transition-all"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
              ><path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.tiktok.com/@grandbedahanresidence"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#E5C695] hover:text-[#0B281F] text-white flex items-center justify-center transition-all"
            aria-label="TikTok"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
              ><path
                d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"
              ></path></svg
            >
          </a>
          <a
            href="https://wa.me/6281215776218"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-[#E5C695] hover:text-[#0B281F] text-white flex items-center justify-center transition-all"
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Col 2: Navigasi (2.5 Cols) -->
      <div class="md:col-span-2">
        <h3
          class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4"
        >
          Navigasi
        </h3>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a href="/#beranda" class="hover:text-[#E5C695] transition-colors"
              >Beranda</a>
          </li>
          <li>
            <a href="/#tentang" class="hover:text-[#E5C695] transition-colors"
              >Tentang Kami</a>
          </li>
          <li>
            <a
              href="/#tipe-rumah"
              class="hover:text-[#E5C695] transition-colors">Tipe Rumah</a>
          </li>
          <li>
            <a href="/#fasilitas" class="hover:text-[#E5C695] transition-colors"
              >Fasilitas</a>
          </li>
          <li>
            <a
              href="/#virtual-tour"
              class="hover:text-[#E5C695] transition-colors">Virtual Tour</a>
          </li>
          <li>
            <a href="/#promo" class="hover:text-[#E5C695] transition-colors"
              >Promo</a>
          </li>
          <li>
            <a href="/#artikel" class="hover:text-[#E5C695] transition-colors"
              >Artikel</a>
          </li>
          <li>
            <a href="/#testimoni" class="hover:text-[#E5C695] transition-colors"
              >Testimoni</a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-[#E5C695] transition-colors"
              >FAQ</a>
          </li>
          <li>
            <a href="/#kontak" class="hover:text-[#E5C695] transition-colors"
              >Kontak</a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Tipe Rumah (2.5 Cols) -->
      <div class="md:col-span-2">
        <h3
          class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4"
        >
          Tipe Rumah
        </h3>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a
              href="/tipe-rumah/tipe-36-72"
              class="hover:text-[#E5C695] transition-colors">Tipe 36/72</a>
          </li>
          <li>
            <a
              href="/tipe-rumah/tipe-45-72"
              class="hover:text-[#E5C695] transition-colors">Tipe 45/72</a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Hubungi Kami (3 Cols) -->
      <div class="md:col-span-4">
        <h3
          class="text-base font-bold text-white tracking-wide uppercase font-serif mb-4"
        >
          Hubungi Kami
        </h3>
        <ul class="space-y-3.5 text-sm text-emerald-100/80">
          <li class="flex items-start gap-3">
            <MapPin className="w-5 h-5 text-[#E5C695] flex-shrink-0 mt-0.5" />
            <span class="leading-relaxed"
              >Jl. Masjid Al-Mukhlisin No.006, RT.002, Bedahan, Kec. Sawangan,
              Kota Depok, Jawa Barat 16519</span
            >
          </li>
          <li class="flex items-center gap-3">
            <Phone className="w-5 h-5 text-[#E5C695] flex-shrink-0" />
            <a
              href="https://wa.me/6281215776218"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#E5C695] font-bold text-white transition-colors"
            >
              0812-1577-6218
            </a>
          </li>
          <li class="flex items-center gap-3">
            <MessageSquare className="w-5 h-5 text-[#E5C695] flex-shrink-0" />
            <span>Layanan: 08.00 - 17.00 WIB</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 text-center text-sm text-emerald-100/60 font-medium">
      <p>&copy; {currentYear} Grand Bedahan Residence. All Rights Reserved.</p>
    </div>
  </div>
</footer>
