---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TentangSection from '../components/sections/TentangSection.astro';
import TipeRumahSection from '../components/sections/TipeRumahSection.astro';
import LokasiSection from '../components/sections/LokasiSection.astro';
import VideoSection from '../components/sections/VideoSection.astro';
import PromosiSection from '../components/sections/PromosiSection.astro';
import ArtikelSection from '../components/sections/ArtikelSection.astro';
import TestimoniSection from '../components/sections/TestimoniSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import KontakSection from '../components/sections/KontakSection.astro';

import FloatingWhatsApp from '../components/islands/FloatingWhatsApp';

const SITE_URL = 'https://grandbedahanresidence.com';
const OG_IMAGE = `${SITE_URL}/assets/banner.webp`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["RealEstateAgent", "LocalBusiness"],
  "name": "Grand Bedahan Residence",
  "alternateName": "GBR Sawangan",
  "slogan": "Perumahan Modern Bebas Banjir di Sawangan Depok",
  "description": "Grand Bedahan Residence adalah perumahan modern bebas banjir di Sawangan, Depok. Menawarkan pilihan rumah berkualitas dengan legalitas SHM, DP 0%, KPR bank, lingkungan asri, one gate system, dan lokasi strategis.",
  "keywords": "Perumahan di Sawangan, Perumahan di Depok, Rumah di Sawangan Depok, Perumahan Sawangan Depok, Perumahan Bebas Banjir Depok, Cluster Sawangan Depok, Grand Bedahan Residence, Rumah Murah Depok, Rumah SHM Sawangan",
  "url": SITE_URL,
  "logo": `${SITE_URL}/android-chrome-512x512.png`,
  "image": OG_IMAGE,
  "telephone": "+6281215776218",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Masjid Al-Mukhlisin No.006, RT.002, Bedahan, Kec. Sawangan",
    "addressLocality": "Depok",
    "addressRegion": "Jawa Barat",
    "postalCode": "16519",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -6.4267651,
    "longitude": 106.7710141
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "08:00",
    "closes": "17:00"
  },
  "hasMap": "https://www.google.com/maps/place/Grand+Bedahan+Residence/@-6.4267651,106.7684392,17z",
  "areaServed": [
    { "@type": "City", "name": "Depok" },
    { "@type": "City", "name": "Sawangan" },
    { "@type": "City", "name": "Bogor" },
    { "@type": "City", "name": "Tangerang Selatan" },
    { "@type": "City", "name": "Jakarta Selatan" }
  ],
  "sameAs": [
    "https://www.instagram.com/grandbedahan.id",
    "https://www.tiktok.com/@grandbedahanresidence"
  ],
  "priceRange": "Rp 500.000.000 - Rp 600.000.000"
};
---

<MainLayout 
  title="Perumahan di Sawangan Depok Bebas Banjir & Asri"
  description="Grand Bedahan Residence — Pilihan utama perumahan di Sawangan, Depok. Hunian modern bebas banjir dengan legalitas SHM, DP 0%, cicilan ringan, one gate system & lokasi strategis dekat tol dan stasiun."
  keywords={[
    "Perumahan di Sawangan",
    "Perumahan di Depok",
    "Rumah di Sawangan Depok",
    "Perumahan Sawangan Depok",
    "Perumahan Bebas Banjir Depok",
    "Rumah Bebas Banjir Sawangan",
    "Grand Bedahan Residence",
    "Cluster Sawangan Depok",
    "Rumah SHM Sawangan Depok",
    "Rumah DP 0 Depok",
    "Perumahan Murah di Depok",
    "Jual Rumah Sawangan Depok",
    "Perumahan Dekat Tol Sawangan",
    "Perumahan Dekat Stasiun Citayam"
  ]}
>
  <!-- JSON-LD LocalBusiness Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <HeroSection />
  <TentangSection />
  <TipeRumahSection />
  <LokasiSection />
  <VideoSection />
  <PromosiSection />
  <ArtikelSection />
  <TestimoniSection />
  <FaqSection />
  <KontakSection />
  
  <FloatingWhatsApp client:load />
</MainLayout>
