---
import MainLayout from '../../layouts/MainLayout.astro';
import { getPublishedArtikelList, getArtikelBySlug } from '../../lib/api';
import { renderMarkdownAndHtml } from '../../lib/markdown';

const { slug } = Astro.params;
const articleItem = Astro.props.articleItem || (await getArtikelBySlug(slug as string));

if (!articleItem) {
  return Astro.redirect('/artikel');
}

const formatDate = (dateString?: string) => {
  if (!dateString) return '';
  const options: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'long', year: 'numeric' };
  return new Date(dateString).toLocaleDateString('id-ID', options);
};

const rawContent = articleItem.isi_konten || '<p>Maaf, konten artikel yang Anda cari tidak tersedia.</p>';
const formattedHtml = renderMarkdownAndHtml(rawContent);

const article = {
  judul: articleItem.judul,
  tanggal: formatDate(articleItem.tanggal_publish),
  gambar_utama_url: articleItem.gambar_utama_url,
  konten: formattedHtml
};
---

<MainLayout title={article.judul}>
  <div class="bg-[--color-background-alt] py-10 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-[--color-text-secondary] mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-[--color-primary] transition-colors">Beranda</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-4 h-4 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <a href="/#artikel" class="hover:text-[--color-primary] transition-colors">Artikel</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-4 h-4 text-gray-400 mx-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="text-gray-400 truncate max-w-[150px] sm:max-w-xs">{article.judul}</span>
            </div>
          </li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 text-center">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[--color-text-main] tracking-tight leading-tight mb-4">
          {article.judul}
        </h1>
        {article.tanggal && (
          <div class="flex items-center justify-center text-[--color-text-secondary] text-sm">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <time>{article.tanggal}</time>
          </div>
        )}
      </header>
      
      <!-- Article Image -->
      {article.gambar_utama_url && (
        <div class="rounded-2xl overflow-hidden shadow-lg mb-12 max-h-[500px]">
          <img 
            src={article.gambar_utama_url} 
            alt={article.judul} 
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Article Content -->
      <div 
        class="prose prose-lg max-w-none prose-headings:text-[--color-text-main] prose-a:text-[--color-primary] hover:prose-a:text-[--color-primary-light] prose-img:rounded-xl"
        set:html={article.konten}
      />
      
      <!-- Footer / Back button -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <a href="/#artikel" class="inline-flex items-center text-[--color-primary] font-medium hover:text-[--color-primary-light] transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Kembali ke Artikel
        </a>
      </div>
      
    </div>
  </div>
</MainLayout>

<style is:global>
  /* Rich styles for prose content rendered from Markdown / HTML */
  .prose h1 {
    margin-top: 1.8em;
    margin-bottom: 0.6em;
    font-weight: 800;
    font-size: 2em;
    color: #17201C;
    line-height: 1.25;
    font-family: serif;
  }
  .prose h2 {
    margin-top: 1.8em;
    margin-bottom: 0.6em;
    font-weight: 700;
    font-size: 1.6em;
    color: #0E3B2E;
    line-height: 1.3;
    font-family: serif;
  }
  .prose h3 {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-weight: 700;
    font-size: 1.3em;
    color: #17201C;
    line-height: 1.35;
  }
  .prose p {
    margin-top: 1.2em;
    margin-bottom: 1.2em;
    color: #4A5568;
    line-height: 1.8;
    font-size: 1.0625rem;
  }
  .prose blockquote {
    margin-top: 1.6em;
    margin-bottom: 1.6em;
    padding: 1rem 1.5rem;
    border-left: 4px solid #0E3B2E;
    background-color: #F4F7F5;
    border-radius: 0 1rem 1rem 0;
    font-style: italic;
    color: #0E3B2E;
    font-weight: 500;
  }
  .prose ul, .prose ol {
    margin-top: 1.2em;
    margin-bottom: 1.2em;
    padding-left: 1.5em;
    color: #4A5568;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-top: 0.4em;
    margin-bottom: 0.4em;
    line-height: 1.7;
  }
  .prose strong {
    font-weight: 700;
    color: #17201C;
  }
  .prose img {
    margin-top: 2em;
    margin-bottom: 2em;
    border-radius: 1.25rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
  }
  .prose a {
    color: #0E3B2E;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    color: #07241C;
  }
  .prose hr {
    margin-top: 2.5em;
    margin-bottom: 2.5em;
    border-color: #E2E8F0;
  }
</style>
