---
import MainLayout from '../../layouts/MainLayout.astro';
import { formatRupiah, type TipeRumah } from '../../data/tipeRumah';
import { getTipeRumahList } from '../../lib/api';
import HouseDetailGallery from '../../components/islands/HouseDetailGallery';
import KprCalculator from '../../components/islands/KprCalculator';
import FloatingWhatsApp from '../../components/islands/FloatingWhatsApp';

import {
  Bed,
  Bath,
  Maximize2,
  Car,
  Layers,
  Zap,
  Droplet,
  CheckCircle2,
  ArrowLeft,
  ArrowRight,
  PhoneCall,
  FileText,
  ShieldCheck,
  Sparkles,
  ChevronRight,
  MessageSquare,
  Home,
  Download,
  Calendar,
  MapPin,
  Clock,
  Compass,
  Check,
  Camera,
  Ruler,
  Map,
  Hammer,
  Calculator,
  ZoomIn,
  X,
  Store
} from 'lucide-react';

const { slug } = Astro.params;
const fullList = await getTipeRumahList();
const tipe = Astro.props.tipe || fullList.find((t) => t.slug === slug);
const allTypes = Astro.props.allTypes || fullList;

if (!tipe) {
  return Astro.redirect('/tipe-rumah');
}

const otherTypes = fullList.filter((t) => t.slug !== tipe.slug);
const isCommercial = 
  tipe.kategori === 'ruko' || 
  tipe.kategori === 'kios' || 
  tipe.slug.includes('ruko') || 
  tipe.slug.includes('kios') || 
  tipe.nama_tipe.toLowerCase().includes('ruko') || 
  tipe.nama_tipe.toLowerCase().includes('kios');

// 1. Fallback Galeri: Gunakan foto utama jika galeri kosong
const galleryPhotos = (tipe.galeri && tipe.galeri.length > 0)
  ? tipe.galeri
  : (tipe.foto_url ? [tipe.foto_url] : []);

// 2. Fallback Deskripsi Lengkap
const deskripsiLengkap = (Array.isArray(tipe.deskripsi_lengkap) && tipe.deskripsi_lengkap.length > 0)
  ? tipe.deskripsi_lengkap
  : [tipe.deskripsi || (isCommercial ? 'Kios komersial strategis siap pakai di gerbang utama Grand Bedahan Residence.' : 'Hunian modern bernuansa asri dan bebas banjir di kawasan strategis Sawangan Depok.')];

// 3. Fallback Fitur Unggulan
const fiturList = (Array.isArray(tipe.fitur) && tipe.fitur.length > 0)
  ? tipe.fitur
  : (isCommercial ? [
    'Luas Bangunan 22 m² (Dimensi 4m x 6.2m)',
    'Lokasi Terdepan Gerbang Utama Kawasan',
    'Tata Ruang Plong / Siap Buka Usaha',
    '1 Kamar Mandi / Toilet Bersih',
    'Sertifikat Hak Milik (SHM) & IMB/PBG Lengkap',
    'Area Parkir Pengunjung Luas & Bebas Banjir'
  ] : [
    'Sertifikat Hak Milik (SHM) & IMB/PBG Sudah Pecah',
    'Row Jalan Perumahan Lebar 6-7 Meter Paving Block',
    'One Gate System dengan Keamanan CCTV 24 Jam',
    'Taman Terbuka Hijau & Area Bermain Ramah Anak',
    'Lokasi Strategis Dekat Pintu Tol & Pusat Kota Depok'
  ]);

// 4. Fallback Spesifikasi Teknis Material
const spesifikasi = {
  pondasi: tipe.spesifikasi?.pondasi || 'Batu Kali & Beton Bertulang',
  struktur: tipe.spesifikasi?.struktur || 'Beton Bertulang SNI',
  dinding: tipe.spesifikasi?.dinding || 'Bata Ringan (Hebel) Plester Aci + Cat Weatherproof',
  lantai: tipe.spesifikasi?.lantai || 'Granit Tile 60x60 cm',
  atap: tipe.spesifikasi?.atap || 'Rangka Baja Ringan + Genteng Flat',
  kusen_pintu: tipe.spesifikasi?.kusen_pintu || (isCommercial ? 'Kusen Aluminium & Pintu Kaca / Rolling Door' : 'Kusen Aluminium & Pintu Solid Engineering'),
  sanitair: tipe.spesifikasi?.sanitair || 'Kloset Duduk Standar + Hand Shower',
  listrik_air: tipe.spesifikasi?.listrik_air || `${tipe.daya_listrik || (isCommercial ? '900 VA' : '1.300 VA')} / ${tipe.sumber_air || 'Sumur Bor + Pompa Listrik'}`
};

const waText = encodeURIComponent(
  `Halo Tim Marketing Grand Bedahan Residence, saya tertarik dan ingin konsultasi lebih lanjut mengenai ${tipe.nama_tipe}. Boleh info pricelist, simulasi KPR, dan jadwalkan survei lokasi?`
);
const waUrl = `https://wa.me/6281215776218?text=${waText}`;

const SITE_URL = 'https://grandbedahanresidence.com';

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${tipe.nama_tipe} — Grand Bedahan Residence`,
  "description": `${tipe.tagline}. Luas bangunan ${tipe.ukuran_bangunan}m², ${isCommercial ? `dimensi ${tipe.dimensi || '4m x 6.2m'}` : `luas tanah ${tipe.ukuran_tanah}m²`}. Pilihan perumahan di Sawangan Depok bebas banjir dengan legalitas SHM.`,
  "keywords": `${tipe.nama_tipe}, Perumahan di Sawangan, Perumahan di Depok, Rumah di Sawangan Depok, Grand Bedahan Residence, Rumah ${tipe.nama_tipe} Depok`,
  "image": galleryPhotos.length > 0 ? galleryPhotos : [`${SITE_URL}/assets/banner.webp`],
  "url": `${SITE_URL}/tipe-rumah/${tipe.slug}/`,
  "sku": `GBR-${tipe.slug.toUpperCase()}`,
  "mpn": `GBR-${tipe.slug.toUpperCase()}`,
  "brand": {
    "@type": "Brand",
    "name": "Grand Bedahan Residence"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "28",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "Andi Pratama"
      },
      "reviewBody": "Lingkungan perumahan sangat nyaman, bebas banjir, akses mudah ke stasiun dan jalan tol, serta legalitas SHM terjamin.",
      "datePublished": "2024-02-10"
    },
    {
      "@type": "Review",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5"
      },
      "author": {
        "@type": "Person",
        "name": "Dewi Lestari"
      },
      "reviewBody": "Desain rumah modern minimalis, sirkulasi udara bagus, dan kualitas bangunan sangat kokoh. Sangat puas tinggal di Grand Bedahan Residence.",
      "datePublished": "2024-03-05"
    }
  ],
  "offers": {
    "@type": "Offer",
    "price": tipe.harga,
    "priceCurrency": "IDR",
    "priceValidUntil": "2026-12-31",
    "validFrom": "2024-01-01",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "url": `${SITE_URL}/tipe-rumah/${tipe.slug}/`,
    "seller": {
      "@type": "Organization",
      "name": "Grand Bedahan Residence",
      "telephone": "+6281215776218"
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "ID",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "0",
        "currency": "IDR"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "ID"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 1,
          "unitCode": "DAY"
        }
      }
    }
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Luas Bangunan", "value": `${tipe.ukuran_bangunan} m²` },
    { "@type": "PropertyValue", "name": "Luas Tanah", "value": `${tipe.ukuran_tanah} m²` },
    { "@type": "PropertyValue", "name": "Kamar Tidur", "value": String(tipe.jumlah_kamar_tidur) },
    { "@type": "PropertyValue", "name": "Kamar Mandi", "value": String(tipe.jumlah_kamar_mandi) },
    { "@type": "PropertyValue", "name": "Carport", "value": String(tipe.jumlah_carport) },
    { "@type": "PropertyValue", "name": "Legalitas", "value": "SHM & IMB/PBG" },
    { "@type": "PropertyValue", "name": "Lokasi", "value": "Sawangan, Depok, Jawa Barat" }
  ]
};
---

<MainLayout 
  title={`${tipe.nama_tipe} | Perumahan di Sawangan Depok - Grand Bedahan Residence`}
  description={`${tipe.nama_tipe} di Grand Bedahan Residence — Perumahan di Sawangan Depok. ${tipe.tagline}. Luas ${tipe.ukuran_bangunan}m², ${isCommercial ? `dimensi ${tipe.dimensi || '4m x 6.2m'}` : `luas tanah ${tipe.ukuran_tanah}m²`}. Legalitas SHM, bebas banjir & cicilan mulai ${tipe.cicilan_mulai}/bulan.`}
  keywords={[
    tipe.nama_tipe,
    "Perumahan di Sawangan",
    "Perumahan di Depok",
    `Rumah ${tipe.nama_tipe} Sawangan`,
    `Rumah ${tipe.nama_tipe} Depok`,
    "Rumah di Sawangan Depok",
    "Perumahan Bebas Banjir Sawangan",
    "Grand Bedahan Residence",
    "Jual Rumah Sawangan Depok"
  ]}
  ogImage={galleryPhotos[0] || undefined}
>
  <!-- JSON-LD RealEstateListing Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(listingSchema)} slot="head" />
  <!-- Top Breadcrumbs & Back Navigation -->
  <div class="bg-[#F5F3EE] border-b border-gray-200/70 pt-24 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <nav class="flex items-center text-xs sm:text-sm text-[#595959]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#0E3B2E] transition-colors flex items-center gap-1">
            <Home className="w-3.5 h-3.5" />
            <span>Beranda</span>
          </a>
          <ChevronRight className="w-4 h-4 mx-1.5 text-gray-400" />
          <a href="/tipe-rumah" class="hover:text-[#0E3B2E] transition-colors">
            Tipe Unit
          </a>
          <ChevronRight className="w-4 h-4 mx-1.5 text-gray-400" />
          <span class="text-[#17201C] font-bold truncate">{tipe.nama_tipe}</span>
        </nav>

        <a
          href="/tipe-rumah"
          class="inline-flex items-center text-xs sm:text-sm font-bold text-[#0E3B2E] hover:text-[#07241C] transition-colors group self-start sm:self-auto"
        >
          <ArrowLeft className="w-4 h-4 mr-1.5 transition-transform group-hover:-translate-x-1" />
          <span>Lihat Semua Tipe Unit</span>
        </a>
      </div>
    </div>
  </div>

  <main class="bg-[#FAF9F6] py-8 sm:py-12 lg:py-16 pb-28 lg:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- HERO HEADER CARD: Title, Tagline, Quick Metrics & Price -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-gray-100 shadow-sm mb-8 lg:mb-12">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-gray-100">
          <div class="max-w-3xl">
            <!-- Badge -->
            {isCommercial ? (
              <div class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#0E3B2E] text-[#E5C695] border border-[#E5C695]/40 text-xs font-extrabold uppercase tracking-wider mb-3">
                <Store className="w-3.5 h-3.5 mr-1.5 text-[#E5C695]" />
                UNIT KOMERSIAL &amp; KIOS USAHA • GRAND BEDAHAN RESIDENCE
              </div>
            ) : (
              <div class="inline-flex items-center px-3.5 py-1 rounded-full bg-emerald-50 text-[#0E3B2E] border border-emerald-200/60 text-xs font-bold uppercase tracking-wider mb-3">
                <Sparkles className="w-3.5 h-3.5 mr-1.5 text-[#E5C695]" />
                CLUSTER EKSKLUSIF • GRAND BEDAHAN RESIDENCE
              </div>
            )}

            <!-- Main Title -->
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#17201C] font-serif tracking-tight">
              {tipe.nama_tipe}
            </h1>

            <!-- Tagline -->
            <p class="mt-2 text-sm sm:text-base lg:text-lg text-[#4A5568] leading-relaxed">
              {tipe.tagline}
            </p>
          </div>

          <!-- Price & Installment Highlight Card -->
          <div class="bg-[#FAF9F6] border border-gray-200/80 rounded-2xl p-5 sm:p-6 lg:min-w-[320px] text-left lg:text-right shrink-0">
            <p class="text-xs uppercase tracking-wider text-gray-500 font-bold">Harga Cash / KPR Mulai</p>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#0E3B2E] font-sans mt-0.5">
              {formatRupiah(tipe.harga)}
            </div>
            <a
              href="#simulasi-kpr"
              class="mt-2 inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#0E3B2E] bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-full border border-emerald-200 transition-all group cursor-pointer shadow-xs hover:shadow-sm"
              title="Klik untuk hitung simulasi cicilan KPR"
            >
              <CheckCircle2 className="w-3.5 h-3.5 text-[#047857]" />
              <span>Cicilan KPR mulai {tipe.cicilan_mulai}</span>
              <ChevronRight className="w-3.5 h-3.5 text-[#047857] transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
        </div>

        <!-- Quick Specs Badges Row (Dynamic for Commercial vs Residential) -->
        <div class="pt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4 text-xs sm:text-sm text-[#17201C] font-semibold">
          {isCommercial ? (
            <>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Maximize2 className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span>Luas Kios: <strong class="text-[#0E3B2E]">{tipe.ukuran_bangunan} m²</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Layers className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span>Dimensi: <strong class="text-[#0E3B2E]">{tipe.dimensi || '4m x 6.2m'}</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Store className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span><strong>Ruang Usaha</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Bath className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span><strong>{tipe.jumlah_kamar_mandi}</strong> Toilet</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Car className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span><strong>Parkir Luas</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <ShieldCheck className="w-4 h-4 text-[#B4833E] shrink-0" />
                <span>Legalitas: <strong class="text-[#0E3B2E]">SHM</strong></span>
              </div>
            </>
          ) : (
            <>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Maximize2 className="w-4 h-4 text-[#047857] shrink-0" />
                <span>Bangunan: <strong class="text-[#0E3B2E]">{tipe.ukuran_bangunan} m²</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Layers className="w-4 h-4 text-[#047857] shrink-0" />
                <span>Tanah: <strong class="text-[#0E3B2E]">{tipe.ukuran_tanah} m²</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Bed className="w-4 h-4 text-[#047857] shrink-0" />
                <span><strong>{tipe.jumlah_kamar_tidur > 0 ? `${tipe.jumlah_kamar_tidur} K. Tidur` : 'Ruang Usaha'}</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Bath className="w-4 h-4 text-[#047857] shrink-0" />
                <span><strong>{tipe.jumlah_kamar_mandi}</strong> K. Mandi</span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <Car className="w-4 h-4 text-[#047857] shrink-0" />
                <span><strong>{tipe.jumlah_carport > 0 ? `${tipe.jumlah_carport} Carport` : 'Tanpa Carport'}</strong></span>
              </div>
              <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50/80 border border-gray-100">
                <ShieldCheck className="w-4 h-4 text-[#047857] shrink-0" />
                <span>Legalitas: <strong class="text-[#0E3B2E]">SHM</strong></span>
              </div>
            </>
          )}
        </div>
      </div>

      <!-- Quick Jump Navigation Tabs (with Lucide Icons) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar text-xs sm:text-sm font-bold">
        <a href="#galeri" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#0E3B2E] text-white whitespace-nowrap shadow-sm">
          <Camera className="w-3.5 h-3.5 text-[#E5C695]" />
          <span>Galeri &amp; Foto</span>
        </a>
        <a href="#spesifikasi" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white text-[#4A5568] hover:text-[#0E3B2E] border border-gray-200 whitespace-nowrap hover:bg-emerald-50 transition-colors">
          <Ruler className="w-3.5 h-3.5 text-[#047857]" />
          <span>Spesifikasi</span>
        </a>
        <a href="#tentang" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white text-[#4A5568] hover:text-[#0E3B2E] border border-gray-200 whitespace-nowrap hover:bg-emerald-50 transition-colors">
          <FileText className="w-3.5 h-3.5 text-[#047857]" />
          <span>Tentang Unit</span>
        </a>
        {tipe.denah_url && (
          <a href="#denah" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white text-[#4A5568] hover:text-[#0E3B2E] border border-gray-200 whitespace-nowrap hover:bg-emerald-50 transition-colors">
            <Map className="w-3.5 h-3.5 text-[#047857]" />
            <span>Denah 2D</span>
          </a>
        )}
        <a href="#material" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white text-[#4A5568] hover:text-[#0E3B2E] border border-gray-200 whitespace-nowrap hover:bg-emerald-50 transition-colors">
          <Hammer className="w-3.5 h-3.5 text-[#047857]" />
          <span>Material</span>
        </a>
        <a href="#simulasi-kpr" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white text-[#4A5568] hover:text-[#0E3B2E] border border-gray-200 whitespace-nowrap hover:bg-emerald-50 transition-colors">
          <Calculator className="w-3.5 h-3.5 text-[#047857]" />
          <span>Simulasi KPR</span>
        </a>
      </div>

      <!-- 2-COLUMN MAIN CONTENT GRID -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- LEFT COLUMN: Media & Deep Info (8 cols) -->
        <div class="lg:col-span-8 space-y-8 sm:space-y-10">
          
          <!-- 1. Interactive Photo Gallery -->
          <section id="galeri" class="scroll-mt-28">
            <div class="bg-white rounded-3xl p-5 sm:p-7 border border-gray-100 shadow-sm">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl sm:text-2xl font-bold text-[#17201C] font-serif">Galeri Foto Unit</h2>
                <span class="text-xs text-gray-500 font-medium">Klik foto untuk perbesar</span>
              </div>
              <HouseDetailGallery client:load photos={galleryPhotos} title={tipe.nama_tipe} />
            </div>
          </section>

          <!-- 2. Ringkasan Spesifikasi Lengkap (8-Grid Cards) -->
          <section id="spesifikasi" class="scroll-mt-28">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
              <h2 class="text-xl sm:text-2xl font-bold text-[#17201C] mb-6 font-serif">Ringkasan Spesifikasi Unit</h2>
              
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5">
                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Maximize2 className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">{isCommercial ? 'Luas Kios' : 'Luas Bangunan'}</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.ukuran_bangunan} m²</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Layers className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">{isCommercial ? 'Tipe Dimensi' : 'Luas Tanah'}</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{isCommercial ? (tipe.dimensi || '4m x 6.2m') : `${tipe.ukuran_tanah} m²`}</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    {isCommercial ? <Store className="w-5 h-5" /> : <Bed className="w-5 h-5" />}
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">{isCommercial ? 'Tipe Ruang' : 'Kamar Tidur'}</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{isCommercial ? 'Ruang Usaha' : (tipe.jumlah_kamar_tidur > 0 ? `${tipe.jumlah_kamar_tidur} Ruang` : 'Ruang Usaha')}</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Bath className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">{isCommercial ? 'Toilet / Sanitasi' : 'Kamar Mandi'}</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.jumlah_kamar_mandi} Ruang</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Car className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">{isCommercial ? 'Area Parkir' : 'Carport'}</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{isCommercial ? 'Parkir Luas' : (tipe.jumlah_carport > 0 ? `${tipe.jumlah_carport} Mobil` : 'Tanpa Carport')}</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Zap className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">Daya Listrik</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.daya_listrik || '1.300 VA'}</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <Droplet className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">Sumber Air</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C] truncate">{tipe.sumber_air || 'Jetpump'}</p>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 flex flex-col justify-between">
                  <div class="w-10 h-10 rounded-xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center mb-3">
                    <ShieldCheck className="w-5 h-5" />
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">Legalitas</p>
                    <p class="text-base sm:text-lg font-bold text-[#17201C]">SHM & IMB</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- 3. Tentang Unit & Keunggulan -->
          <section id="tentang" class="scroll-mt-28">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
              <h2 class="text-xl sm:text-2xl font-bold text-[#17201C] font-serif">Tentang {tipe.nama_tipe}</h2>
              <div class="prose max-w-none text-[#4A5568] space-y-3.5 leading-relaxed text-sm sm:text-base">
                {deskripsiLengkap.map((paragraf) => (
                  <p>{paragraf}</p>
                ))}
              </div>

              <!-- Keunggulan Unit List -->
              <div class="pt-6 border-t border-gray-100">
                <h3 class="text-lg sm:text-xl font-bold text-[#17201C] mb-4 font-serif">Fitur & Keunggulan Utama:</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {fiturList.map((item) => (
                    <div class="flex items-start gap-3 p-3.5 rounded-xl bg-[#FAF9F6] border border-gray-100">
                      <div class="w-5 h-5 rounded-full bg-[#0E3B2E] text-white flex items-center justify-center shrink-0 mt-0.5">
                        <Check className="w-3.5 h-3.5 stroke-[3]" />
                      </div>
                      <span class="text-xs sm:text-sm font-semibold text-[#17201C]">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>

          <!-- 4. Denah Tata Ruang 2D (Interactive Lightbox) -->
          {tipe.denah_url && (
            <section id="denah" class="scroll-mt-28">
              <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-3">
                  <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-[#17201C] font-serif">Denah &amp; Tata Ruang 2D</h2>
                    <p class="text-xs sm:text-sm text-[#595959] mt-1">Layout arsitektur fungsional dengan pencahayaan dan sirkulasi alami</p>
                  </div>
                  <a
                    href={waUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-[#0E3B2E] bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors self-start sm:self-auto"
                  >
                    <Download className="w-4 h-4" />
                    <span>Minta Denah PDF</span>
                  </a>
                </div>

                <!-- Clickable Floorplan Container with Zoom Hint -->
                <div
                  id="denah-trigger"
                  class="relative rounded-2xl overflow-hidden bg-[#FAF9F6] border border-gray-200 aspect-[16/10] sm:aspect-[16/9] flex items-center justify-center p-4 sm:p-8 cursor-zoom-in group"
                >
                  <img
                    src={tipe.denah_url}
                    alt={`Denah Arsitektur ${tipe.nama_tipe}`}
                    class="max-h-full max-w-full object-contain rounded-xl shadow-xs transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute bottom-4 right-4 bg-[#0E3B2E]/90 text-white text-xs font-bold px-3.5 py-1.5 rounded-full flex items-center gap-1.5 backdrop-blur-sm shadow-md transition-transform group-hover:scale-105">
                    <ZoomIn className="w-3.5 h-3.5" />
                    <span>Klik untuk perbesar</span>
                  </div>
                </div>
              </div>

              <!-- Denah Lightbox Modal -->
              <div
                id="denah-lightbox"
                class="fixed inset-0 z-[9999] bg-black/90 backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 p-4 sm:p-8"
              >
                <div id="denah-modal-content" class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center">
                  <button
                    id="denah-close-btn"
                    class="absolute -top-3 -right-3 z-10 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg hover:bg-gray-100 transition-colors text-black font-bold cursor-pointer"
                    aria-label="Tutup"
                  >
                    <X className="w-5 h-5 text-gray-800" />
                  </button>
                  <img
                    src={tipe.denah_url}
                    alt={`Denah Arsitektur ${tipe.nama_tipe} - Full Size`}
                    class="w-full object-contain rounded-2xl shadow-2xl max-h-[80vh] bg-white p-2"
                  />
                  <p class="text-center text-white/70 text-xs mt-3">Klik tombol tutup atau tekan Esc untuk kembali</p>
                </div>
              </div>

              <script>
                const trigger = document.getElementById('denah-trigger');
                const lightbox = document.getElementById('denah-lightbox');
                const closeBtn = document.getElementById('denah-close-btn');

                const openLightbox = () => {
                  if (lightbox) {
                    lightbox.classList.remove('opacity-0', 'pointer-events-none');
                    lightbox.classList.add('opacity-100');
                    document.body.style.overflow = 'hidden';
                  }
                };

                const closeLightbox = () => {
                  if (lightbox) {
                    lightbox.classList.add('opacity-0', 'pointer-events-none');
                    lightbox.classList.remove('opacity-100');
                    document.body.style.overflow = '';
                  }
                };

                trigger?.addEventListener('click', openLightbox);
                closeBtn?.addEventListener('click', closeLightbox);
                lightbox?.addEventListener('click', (e) => {
                  if (e.target === lightbox) closeLightbox();
                });
                document.addEventListener('keydown', (e) => {
                  if (e.key === 'Escape') closeLightbox();
                });
              </script>
            </section>
          )}

          <!-- 5. Detail Spesifikasi Material Bangunan -->
          <section id="material" class="scroll-mt-28">
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
              <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl sm:text-2xl font-bold text-[#17201C] font-serif">Spesifikasi Material Berkualitas</h2>
                <span class="text-xs text-gray-500 font-medium">Standar SNI & Premium</span>
              </div>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Pondasi &amp; Struktur</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.pondasi} • {spesifikasi.struktur}</p>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Dinding Bangunan</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.dinding}</p>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Lantai Utama</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.lantai}</p>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Atap &amp; Rangka</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.atap}</p>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Kusen &amp; Daun Pintu</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.kusen_pintu}</p>
                </div>

                <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Sanitair Kamar Mandi</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.sanitair}</p>
                </div>

                <div class="sm:col-span-2 p-4 rounded-2xl bg-[#FAF9F6] border border-gray-100 space-y-1">
                  <p class="font-bold text-[#0E3B2E] uppercase text-[11px] tracking-wider">Instalasi Listrik &amp; Air</p>
                  <p class="text-[#17201C] font-semibold">{spesifikasi.listrik_air}</p>
                </div>
              </div>
            </div>
          </section>

          <!-- 6. Interactive KPR Simulator Island -->
          <section id="simulasi-kpr" class="scroll-mt-28">
            <KprCalculator client:load hargaRumah={tipe.harga} tipeNama={tipe.nama_tipe} />
          </section>

        </div>

        <!-- RIGHT COLUMN: Sticky Booking & Consultation Sidebar (4 cols) -->
        <aside class="hidden lg:block lg:col-span-4 space-y-6 sticky top-28">
          
          <!-- Booking & Contact Card -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-emerald-900/10 shadow-xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-emerald-50/60 rounded-full blur-3xl -z-10"></div>
            
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[#0E3B2E] text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-200/60">
              <Sparkles className="w-3.5 h-3.5 text-[#E5C695]" />
              <span>Promo Terbatas Bulan Ini</span>
            </div>

            <h3 class="text-2xl font-bold text-[#17201C] font-serif mb-2 leading-snug">
              Tertarik dengan Unit {tipe.nama_tipe}?
            </h3>
            
            <p class="text-sm text-[#4A5568] mb-5 leading-relaxed">
              Dapatkan konsultasi gratis, simulasi KPR bank, brosur PDF, dan jadwalkan kunjungan survei unit bersama tim kami.
            </p>

            <!-- Promo Perks List -->
            <div class="mb-6 p-4 bg-emerald-50/80 rounded-2xl border border-emerald-200/70 space-y-2.5 text-xs sm:text-sm font-semibold text-[#0E3B2E]">
              <div class="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-[#047857] shrink-0 mt-0.5" />
                <span>Promo DP 0% & Bebas Biaya KPR</span>
              </div>
              <div class="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-[#047857] shrink-0 mt-0.5" />
                <span>Gratis BPHTB, AJB, dan Balik Nama SHM</span>
              </div>
              <div class="flex items-start gap-2">
                <CheckCircle2 className="w-4 h-4 text-[#047857] shrink-0 mt-0.5" />
                <span>Bonus Smart Door Lock & Toren Air</span>
              </div>
            </div>

            <!-- Primary Action Buttons -->
            <div class="space-y-3">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2 py-4 px-6 bg-[#0E3B2E] hover:bg-[#07241C] text-white font-bold text-base rounded-2xl shadow-lg hover:shadow-xl transition-all hover:scale-[1.01]"
              >
                <PhoneCall className="w-5 h-5 text-[#E5C695]" />
                <span>Konsultasi WhatsApp & Survei</span>
              </a>

              <a
                href="/#kontak"
                class="w-full flex items-center justify-center gap-2 py-3.5 px-6 bg-emerald-50 hover:bg-emerald-100 text-[#0E3B2E] border border-emerald-200 font-bold text-sm rounded-2xl transition-colors"
              >
                <MessageSquare className="w-4 h-4 text-[#0E3B2E]" />
                <span>Tinggalkan Pesan Form</span>
              </a>
            </div>

            <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-center gap-1.5 text-center text-xs text-gray-500 font-medium">
              <Zap className="w-3.5 h-3.5 text-[#047857]" />
              <span>Respon cepat • Tanpa biaya perantara</span>
            </div>
          </div>

          <!-- Other Units Switcher Card -->
          <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm">
            <h4 class="font-bold text-[#17201C] text-lg mb-4 font-serif">Pilihan Tipe Rumah Lainnya</h4>
            <div class="space-y-3">
              {otherTypes.map((item) => (
                <a
                  href={`/tipe-rumah/${item.slug}`}
                  class="flex items-center gap-3.5 p-3 rounded-2xl hover:bg-emerald-50/60 border border-transparent hover:border-emerald-100 transition-all group"
                >
                  <img
                    src={item.foto_url}
                    alt={item.nama_tipe}
                    class="w-16 h-16 rounded-xl object-cover shrink-0 shadow-xs"
                  />
                  <div class="flex-grow min-w-0">
                    <p class="text-sm font-bold text-[#17201C] group-hover:text-[#0E3B2E] transition-colors truncate">
                      {item.nama_tipe}
                    </p>
                    <p class="text-sm font-bold text-[#0E3B2E]">
                      {formatRupiah(item.harga)}
                    </p>
                    <p class="text-[11px] text-[#595959] mt-0.5">
                      LB: {item.ukuran_bangunan} m² • LT: {item.ukuran_tanah} m²
                    </p>
                  </div>
                  <ChevronRight className="w-4 h-4 text-gray-400 group-hover:text-[#0E3B2E] shrink-0 transition-transform group-hover:translate-x-1" />
                </a>
              ))}
            </div>
          </div>

        </aside>

      </div>

      <!-- BOTTOM BANNER: Ready to visit on-site -->
      <div class="mt-12 lg:mt-16 bg-gradient-to-br from-[#07241C] to-[#0E3B2E] rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
          <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#E5C695] text-xs font-bold uppercase tracking-wider mb-4">
            <MapPin className="w-3.5 h-3.5 text-[#E5C695]" />
            <span>KUNJUNGAN LOKASI</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold font-serif mb-3 leading-tight">
            Ingin Melihat Langsung Unit {tipe.nama_tipe}?
          </h2>
          <p class="text-emerald-50/90 text-sm sm:text-base mb-6 leading-relaxed">
            Kunjungi rumah contoh dan kawasan Grand Bedahan Residence di Jl. Bedahan, Sawangan, Kota Depok. Tim kami siap mendampingi Anda setiap hari.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-bold text-sm sm:text-base text-[#07241C] bg-[#E5C695] hover:bg-[#edd8b6] transition-all shadow-md"
            >
              <Calendar className="w-4 h-4" />
              <span>Jadwalkan Kunjungan Survei</span>
            </a>
            <a
              href="https://www.google.com/maps/place/Grand+Bedahan+Residence/@-6.4267651,106.7684392,17z/data=!3m1!4b1!4m6!3m5!1s0x2e69e9006c4b7593:0xb85a545d9b9e5a93!8m2!3d-6.4267651!4d106.7710141!16s%2Fg%2F11x65k2kvr?hl=id&entry=ttu&g_ep=EgoyMDI2MDgxOS4wIKXMDSoASAFQAw%3D%3D"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full font-bold text-sm sm:text-base text-white border border-white/40 hover:bg-white/10 transition-all group"
            >
              <MapPin className="w-4 h-4 text-[#E5C695]" />
              <span>Petunjuk Arah (Google Maps)</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- MOBILE STICKY BOTTOM ACTION BAR (Effortless Inquiry on Phones) -->
  <div class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-white/95 backdrop-blur-md border-t border-gray-200 p-3 sm:p-4 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
      <a href="#simulasi-kpr" class="block cursor-pointer group">
        <p class="text-[10px] text-gray-500 uppercase tracking-wider font-bold">Harga Unit</p>
        <p class="text-base sm:text-lg font-bold text-[#0E3B2E] font-sans leading-tight">{formatRupiah(tipe.harga)}</p>
        <p class="text-[11px] text-[#0E3B2E] font-semibold flex items-center gap-0.5 mt-0.5">
          <span>Cicilan {tipe.cicilan_mulai}</span>
          <ChevronRight className="w-3 h-3 transition-transform group-hover:translate-x-0.5" />
        </p>
      </a>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-bold text-xs sm:text-sm text-white bg-[#0E3B2E] hover:bg-[#07241C] shadow-md active:scale-95 transition-all"
      >
        <PhoneCall className="w-4 h-4 text-[#E5C695]" />
        <span>Konsultasi / Survei</span>
      </a>
    </div>
  </div>

  <div class="hidden lg:block">
    <FloatingWhatsApp client:load />
  </div>

  <style is:global>
    @media (max-width: 1023px) {
      #benix-cs-widget-container,
      #benix-cs-widget-button,
      div[id*="benix"] {
        bottom: 5.5rem !important;
      }
    }
  </style>
</MainLayout>
