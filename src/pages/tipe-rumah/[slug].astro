---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarTipeRumah, formatRupiah, type TipeRumah } from '../../data/tipeRumah';
import HouseDetailGallery from '../../components/islands/HouseDetailGallery';
import FloatingWhatsApp from '../../components/islands/FloatingWhatsApp';
import ChatbotWidget from '../../components/islands/ChatbotWidget';
import {
  Bed,
  Bath,
  Maximize2,
  Car,
  Layers,
  Zap,
  Droplet,
  CheckCircle2,
  ArrowLeft,
  PhoneCall,
  FileText,
  Calendar,
  ShieldCheck,
  MapPin,
  Sparkles,
  ChevronRight
} from 'lucide-react';

export function getStaticPaths() {
  return daftarTipeRumah.map((tipe) => ({
    params: { slug: tipe.slug },
    props: { tipe }
  }));
}

interface Props {
  tipe: TipeRumah;
}

const { tipe } = Astro.props;

if (!tipe) {
  return Astro.redirect('/#tipe-rumah');
}

const otherTypes = daftarTipeRumah.filter((t) => t.slug !== tipe.slug);
const waText = encodeURIComponent(
  `Halo Tim Marketing Grand Bedahan Residence, saya tertarik dan ingin konsultasi lebih lanjut mengenai ${tipe.nama_tipe}. Boleh info promo & jadwal survei lokasi?`
);
const waUrl = `https://wa.me/6281215776218?text=${waText}`;
---

<MainLayout title={`${tipe.nama_tipe} | Spesifikasi, Denah & Harga`}>
  <!-- Top Breadcrumb Bar -->
  <div class="bg-[#F5F3EE] border-b border-gray-200/70 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center text-xs sm:text-sm text-[#595959]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#047857] transition-colors">Beranda</a>
        <ChevronRight className="w-4 h-4 mx-2 text-gray-400" />
        <a href="/#tipe-rumah" class="hover:text-[#047857] transition-colors">Tipe Rumah</a>
        <ChevronRight className="w-4 h-4 mx-2 text-gray-400" />
        <span class="text-[#17201C] font-semibold truncate">{tipe.nama_tipe}</span>
      </nav>
    </div>
  </div>

  <div class="bg-[#FAF9F6] py-8 sm:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <div class="mb-6">
        <a
          href="/#tipe-rumah"
          class="inline-flex items-center text-sm font-semibold text-[#047857] hover:text-[#065F46] transition-colors group"
        >
          <ArrowLeft className="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1" />
          Kembali ke Pilihan Tipe Rumah
        </a>
      </div>

      <!-- Main Header Info -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8 border-b border-gray-200 mb-8">
        <div>
          <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-100 text-[#047857] text-xs font-semibold uppercase tracking-wider mb-3">
            <Sparkles className="w-3.5 h-3.5 mr-1.5" />
            Unit Siap Huni & Indent
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#17201C] font-serif tracking-tight">
            {tipe.nama_tipe}
          </h1>
          <p class="mt-2 text-base sm:text-lg text-[#34413B] max-w-2xl">
            {tipe.tagline}
          </p>
        </div>

        <div class="lg:text-right bg-white p-5 rounded-2xl border border-gray-100 shadow-sm lg:shadow-none lg:bg-transparent lg:p-0">
          <p class="text-xs sm:text-sm text-[#595959] uppercase tracking-wider font-semibold">Harga Mulai</p>
          <p class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#047857] font-serif">
            {formatRupiah(tipe.harga)}
          </p>
          <p class="text-xs sm:text-sm text-[#34413B] mt-1 font-medium">
            Estimasi Cicilan KPR: <span class="font-semibold text-[#047857]">{tipe.cicilan_mulai}</span>
          </p>
        </div>
      </div>

      <!-- 2-Column Grid: Left (Media & Details) / Right (Sticky Inquiry Card) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left Content (8 cols) -->
        <div class="lg:col-span-8 space-y-10">
          
          <!-- Interactive Photo Gallery Island -->
          <HouseDetailGallery client:load photos={tipe.galeri} title={tipe.nama_tipe} />

          <!-- Key Highlights Specs Grid (Lucide Icons) -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <h2 class="text-xl font-bold text-[#17201C] mb-6 font-serif">Ringkasan Spesifikasi Utama</h2>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Maximize2 className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Luas Bangunan</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.ukuran_bangunan} m²</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Layers className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Luas Tanah</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.ukuran_tanah} m²</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Bed className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Kamar Tidur</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.jumlah_kamar_tidur} Ruang</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Bath className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Kamar Mandi</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.jumlah_kamar_mandi} Ruang</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Car className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Carport Mobil</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.jumlah_carport} Mobil</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Zap className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Daya Listrik</p>
                  <p class="text-base font-bold text-[#17201C]">{tipe.daya_listrik}</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <Droplet className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Sumber Air</p>
                  <p class="text-base font-bold text-[#17201C]">Jetpump</p>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#047857] flex items-center justify-center shrink-0">
                  <ShieldCheck className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs text-[#595959]">Legalitas</p>
                  <p class="text-base font-bold text-[#17201C]">SHM & IMB</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Description Section -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-4">
            <h2 class="text-2xl font-bold text-[#17201C] font-serif">Tentang {tipe.nama_tipe}</h2>
            <div class="prose max-w-none text-[#34413B] space-y-3 leading-relaxed text-sm sm:text-base">
              {tipe.deskripsi_lengkap.map((paragraf) => (
                <p>{paragraf}</p>
              ))}
            </div>

            <!-- Fitur Unggulan List -->
            <div class="pt-6 border-t border-gray-100">
              <h3 class="text-lg font-bold text-[#17201C] mb-4 font-serif">Keunggulan & Fitur Unit:</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {tipe.fitur.map((item) => (
                  <div class="flex items-start gap-2.5">
                    <CheckCircle2 className="w-5 h-5 text-[#047857] shrink-0 mt-0.5" />
                    <span class="text-sm font-medium text-[#17201C]">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Denah Layout (Floor Plan) -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-2">
              <div>
                <h2 class="text-2xl font-bold text-[#17201C] font-serif">Denah & Tata Ruang 2D</h2>
                <p class="text-sm text-[#595959]">Layout arsitektur optimal dengan sirkulasi pencahayaan dan udara alami.</p>
              </div>
              <a
                href={waUrl}
                target="_blank"
                class="inline-flex items-center text-xs font-semibold text-[#047857] hover:underline"
              >
                <FileText className="w-4 h-4 mr-1" />
                Minta Denah High-Res (PDF)
              </a>
            </div>

            <div class="relative rounded-xl overflow-hidden bg-gray-50 border border-gray-200 aspect-[16/10] flex items-center justify-center p-4">
              <img
                src={tipe.denah_url}
                alt={`Denah Arsitektur ${tipe.nama_tipe}`}
                class="max-h-full max-w-full object-contain rounded-lg shadow-sm"
              />
            </div>
          </div>

          <!-- Detail Spesifikasi Bangunan (Material) -->
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#17201C] mb-6 font-serif">Spesifikasi Teknis Material</h2>
            
            <div class="divide-y divide-gray-100 text-sm">
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Pondasi & Struktur</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.pondasi} / {tipe.spesifikasi.struktur}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Dinding</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.dinding}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Lantai</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.lantai}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Atap & Rangka</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.atap}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Kusen & Pintu</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.kusen_pintu}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Sanitair</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.sanitair}</span>
              </div>
              <div class="py-3.5 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-semibold text-[#17201C]">Instalasi Listrik & Air</span>
                <span class="sm:col-span-2 text-[#34413B]">{tipe.spesifikasi.listrik_air}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column (4 cols) — Sticky Action Card -->
        <div class="lg:col-span-4">
          <div class="sticky top-24 space-y-6">
            
            <!-- Booking & Consultation Card -->
            <div class="bg-white rounded-2xl p-6 sm:p-7 border border-emerald-100 shadow-xl relative overflow-hidden">
              <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-50 rounded-full blur-2xl -z-10"></div>
              
              <h3 class="text-xl font-bold text-[#17201C] font-serif mb-2">
                Tertarik dengan Unit Ini?
              </h3>
              <p class="text-xs text-[#595959] mb-6 leading-relaxed">
                Hubungi Marketing Executive kami untuk mendapatkan e-brosur, pricelist terbaru, simulasi KPR bank, dan jadwalkan survei lokasi.
              </p>

              <!-- Promo Highlights Pill -->
              <div class="mb-6 p-3.5 bg-emerald-50/80 rounded-xl border border-emerald-100 space-y-2">
                <div class="flex items-center text-xs font-semibold text-[#047857]">
                  <CheckCircle2 className="w-4 h-4 mr-2 shrink-0" />
                  Promo DP 0% & Bebas Biaya KPR
                </div>
                <div class="flex items-center text-xs font-semibold text-[#047857]">
                  <CheckCircle2 className="w-4 h-4 mr-2 shrink-0" />
                  Gratis Biaya Surat-Surat (BPHTB, AJB, SHM)
                </div>
                <div class="flex items-center text-xs font-semibold text-[#047857]">
                  <CheckCircle2 className="w-4 h-4 mr-2 shrink-0" />
                  Hadiah Langsung Smart Door Lock
                </div>
              </div>

              <!-- Main Action Buttons -->
              <div class="space-y-3">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center py-3.5 px-4 bg-[#047857] hover:bg-[#065F46] text-white font-semibold text-sm rounded-xl shadow-md transition-all hover:scale-[1.02]"
                >
                  <PhoneCall className="w-4 h-4 mr-2" />
                  Konsultasi WhatsApp & Survei
                </a>

                <a
                  href="/#kontak"
                  class="w-full flex items-center justify-center py-3 px-4 bg-white hover:bg-emerald-50 text-[#047857] border border-[#047857] font-semibold text-sm rounded-xl transition-colors"
                >
                  <FileText className="w-4 h-4 mr-2" />
                  Tinggalkan Pesan di Form
                </a>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-100 text-center">
                <p class="text-[11px] text-gray-400">
                  Respon cepat 24/7 • Tanpa biaya konsultasi & perantara
                </p>
              </div>
            </div>

            <!-- Other Types Teaser Card -->
            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
              <h4 class="font-bold text-[#17201C] text-base mb-4 font-serif">Pilihan Tipe Rumah Lainnya</h4>
              <div class="space-y-4">
                {otherTypes.map((item) => (
                  <a
                    href={`/tipe-rumah/${item.slug}`}
                    class="flex items-center gap-3 p-2 rounded-xl hover:bg-gray-50 transition-colors group"
                  >
                    <img
                      src={item.foto_url}
                      alt={item.nama_tipe}
                      class="w-16 h-16 rounded-lg object-cover shrink-0"
                    />
                    <div class="flex-grow min-w-0">
                      <p class="text-sm font-semibold text-[#17201C] group-hover:text-[#047857] transition-colors truncate">
                        {item.nama_tipe}
                      </p>
                      <p class="text-xs font-bold text-[#047857] mt-0.5">
                        {formatRupiah(item.harga)}
                      </p>
                      <p class="text-[11px] text-[#595959]">
                        LB: {item.ukuran_bangunan}m² • LT: {item.ukuran_tanah}m²
                      </p>
                    </div>
                    <ChevronRight className="w-4 h-4 text-gray-400 group-hover:text-[#047857] shrink-0" />
                  </a>
                ))}
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <FloatingWhatsApp client:load />
  <ChatbotWidget client:load />
</MainLayout>
