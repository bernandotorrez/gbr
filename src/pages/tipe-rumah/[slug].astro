---
import MainLayout from '../../layouts/MainLayout.astro';
import { daftarTipeRumah, formatRupiah, type TipeRumah } from '../../data/tipeRumah';
import HouseDetailGallery from '../../components/islands/HouseDetailGallery';
import FloatingWhatsApp from '../../components/islands/FloatingWhatsApp';
import ChatbotWidget from '../../components/islands/ChatbotWidget';
import {
  Bed,
  Bath,
  Maximize2,
  Car,
  Layers,
  Zap,
  Droplet,
  CheckCircle2,
  ArrowLeft,
  PhoneCall,
  FileText,
  ShieldCheck,
  Sparkles,
  ChevronRight,
  MessageSquare
} from 'lucide-react';

export function getStaticPaths() {
  return daftarTipeRumah.map((tipe) => ({
    params: { slug: tipe.slug },
    props: { tipe }
  }));
}

interface Props {
  tipe: TipeRumah;
}

const { tipe } = Astro.props;

if (!tipe) {
  return Astro.redirect('/#tipe-rumah');
}

const otherTypes = daftarTipeRumah.filter((t) => t.slug !== tipe.slug);
const waText = encodeURIComponent(
  `Halo Tim Marketing Grand Bedahan Residence, saya tertarik dan ingin konsultasi lebih lanjut mengenai ${tipe.nama_tipe}. Boleh info promo & jadwal survei lokasi?`
);
const waUrl = `https://wa.me/6281215776218?text=${waText}`;
---

<MainLayout title={`${tipe.nama_tipe} | Spesifikasi, Denah & Harga`}>
  <!-- Top Breadcrumb Bar -->
  <div class="bg-[#F5F3EE] border-b border-gray-200/70 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center text-sm font-medium text-[#595959]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0E3B2E] transition-colors">Beranda</a>
        <ChevronRight className="w-4 h-4 mx-2 text-gray-400" />
        <a href="/#tipe-rumah" class="hover:text-[#0E3B2E] transition-colors">Tipe Rumah</a>
        <ChevronRight className="w-4 h-4 mx-2 text-gray-400" />
        <span class="text-[#17201C] font-bold truncate">{tipe.nama_tipe}</span>
      </nav>
    </div>
  </div>

  <div class="bg-[#FAF9F6] py-8 sm:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <div class="mb-8">
        <a
          href="/#tipe-rumah"
          class="inline-flex items-center text-base font-bold text-[#0E3B2E] hover:text-[#07241C] transition-colors group"
        >
          <ArrowLeft className="w-5 h-5 mr-2 transition-transform group-hover:-translate-x-1" />
          <span>Kembali ke Pilihan Tipe Rumah</span>
        </a>
      </div>

      <!-- Main Header Info -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8 border-b border-gray-200 mb-10">
        <div>
          <div class="inline-flex items-center px-3.5 py-1.5 rounded-full bg-emerald-50 text-[#0E3B2E] border border-emerald-200/60 text-xs sm:text-sm font-bold uppercase tracking-wider mb-3">
            <Sparkles className="w-4 h-4 mr-1.5 text-[#E5C695]" />
            Unit Siap Huni & Indent
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#17201C] font-serif tracking-tight">
            {tipe.nama_tipe}
          </h1>
          <p class="mt-2.5 text-base sm:text-lg text-[#4A5568] max-w-2xl leading-relaxed">
            {tipe.tagline}
          </p>
        </div>

        <div class="lg:text-right bg-white p-6 rounded-2xl border border-gray-100 shadow-sm lg:shadow-none lg:bg-transparent lg:p-0">
          <p class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider font-bold">Harga Unit</p>
          <p class="text-3xl sm:text-4xl font-bold text-[#0E3B2E] font-sans mt-0.5">
            {formatRupiah(tipe.harga)}
          </p>
          <p class="text-sm sm:text-base text-[#4A5568] mt-1 font-medium">
            Estimasi Cicilan KPR: <span class="font-bold text-[#0E3B2E]">{tipe.cicilan_mulai}</span>
          </p>
        </div>
      </div>

      <!-- 2-Column Grid: Left (Media & Details) / Right (Sticky Inquiry Card) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Content (8 cols) -->
        <div class="lg:col-span-8 space-y-10">
          
          <!-- Interactive Photo Gallery Island -->
          <HouseDetailGallery client:load photos={tipe.galeri} title={tipe.nama_tipe} />

          <!-- Key Highlights Specs Grid -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#17201C] mb-6 font-serif">Ringkasan Spesifikasi Utama</h2>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Maximize2 className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Luas Bangunan</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.ukuran_bangunan} m²</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Layers className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Luas Tanah</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.ukuran_tanah} m²</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Bed className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Kamar Tidur</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.jumlah_kamar_tidur} Ruang</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Bath className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Kamar Mandi</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.jumlah_kamar_mandi} Ruang</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Car className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Carport</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.jumlah_carport} Mobil</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Zap className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Daya Listrik</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">{tipe.daya_listrik}</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <Droplet className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Sumber Air</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">Jetpump</p>
                </div>
              </div>

              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0E3B2E] border border-emerald-100 flex items-center justify-center shrink-0">
                  <ShieldCheck className="w-6 h-6" />
                </div>
                <div>
                  <p class="text-xs sm:text-sm text-gray-500 font-medium">Legalitas</p>
                  <p class="text-base sm:text-lg font-bold text-[#17201C]">SHM & IMB</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Description Section -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-5">
            <h2 class="text-2xl font-bold text-[#17201C] font-serif">Tentang {tipe.nama_tipe}</h2>
            <div class="prose max-w-none text-[#4A5568] space-y-3 leading-relaxed text-base sm:text-lg">
              {tipe.deskripsi_lengkap.map((paragraf) => (
                <p>{paragraf}</p>
              ))}
            </div>

            <!-- Fitur Unggulan List -->
            <div class="pt-6 border-t border-gray-100">
              <h3 class="text-xl font-bold text-[#17201C] mb-4 font-serif">Keunggulan & Fitur Unit:</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                {tipe.fitur.map((item) => (
                  <div class="flex items-start gap-3 p-3 rounded-xl bg-gray-50/70 border border-gray-100">
                    <CheckCircle2 className="w-5 h-5 text-[#0E3B2E] shrink-0 mt-0.5" />
                    <span class="text-sm sm:text-base font-bold text-[#17201C]">{item}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Denah Layout (Floor Plan) -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-2">
              <div>
                <h2 class="text-2xl font-bold text-[#17201C] font-serif">Denah & Tata Ruang 2D</h2>
                <p class="text-sm sm:text-base text-[#4A5568] mt-1">Layout arsitektur optimal dengan sirkulasi pencahayaan dan udara alami.</p>
              </div>
              <a
                href={waUrl}
                target="_blank"
                class="inline-flex items-center text-sm font-bold text-[#0E3B2E] hover:text-[#07241C] transition-colors"
              >
                <FileText className="w-4 h-4 mr-1.5" />
                Minta Denah High-Res (PDF)
              </a>
            </div>

            <div class="relative rounded-2xl overflow-hidden bg-gray-50 border border-gray-200 aspect-[16/10] flex items-center justify-center p-4 sm:p-6">
              <img
                src={tipe.denah_url}
                alt={`Denah Arsitektur ${tipe.nama_tipe}`}
                class="max-h-full max-w-full object-contain rounded-xl shadow-sm"
              />
            </div>
          </div>

          <!-- Detail Spesifikasi Bangunan (Material) -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#17201C] mb-6 font-serif">Spesifikasi Teknis Material</h2>
            
            <div class="divide-y divide-gray-100 text-base">
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Pondasi & Struktur</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.pondasi} / {tipe.spesifikasi.struktur}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Dinding</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.dinding}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Lantai</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.lantai}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Atap & Rangka</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.atap}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Kusen & Pintu</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.kusen_pintu}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Sanitair</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.sanitair}</span>
              </div>
              <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2">
                <span class="font-bold text-[#17201C]">Instalasi Listrik & Air</span>
                <span class="sm:col-span-2 text-[#4A5568]">{tipe.spesifikasi.listrik_air}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Column (4 cols) — Sticky Action Card -->
        <div class="lg:col-span-4">
          <div class="sticky top-24 space-y-6">
            
            <!-- Booking & Consultation Card -->
            <div class="bg-white rounded-3xl p-6 sm:p-8 border border-emerald-900/10 shadow-xl relative overflow-hidden">
              <div class="absolute top-0 right-0 w-36 h-36 bg-emerald-50 rounded-full blur-3xl -z-10"></div>
              
              <h3 class="text-2xl sm:text-3xl font-bold text-[#17201C] font-serif mb-3 leading-snug">
                Tertarik dengan Unit Ini?
              </h3>
              <p class="text-sm sm:text-base text-[#4A5568] mb-6 leading-relaxed">
                Hubungi Marketing Executive kami untuk mendapatkan e-brosur, pricelist terbaru, simulasi KPR bank, dan jadwalkan survei lokasi.
              </p>

              <!-- Promo Highlights Pill -->
              <div class="mb-6 p-4 sm:p-5 bg-emerald-50/80 rounded-2xl border border-emerald-200/70 space-y-3">
                <div class="flex items-start text-sm sm:text-base font-bold text-[#0E3B2E] gap-2.5">
                  <CheckCircle2 className="w-5 h-5 text-[#0E3B2E] shrink-0 mt-0.5" />
                  <span>Promo DP 0% & Bebas Biaya KPR</span>
                </div>
                <div class="flex items-start text-sm sm:text-base font-bold text-[#0E3B2E] gap-2.5">
                  <CheckCircle2 className="w-5 h-5 text-[#0E3B2E] shrink-0 mt-0.5" />
                  <span>Gratis Biaya Surat-Surat (BPHTB, AJB, SHM)</span>
                </div>
                <div class="flex items-start text-sm sm:text-base font-bold text-[#0E3B2E] gap-2.5">
                  <CheckCircle2 className="w-5 h-5 text-[#0E3B2E] shrink-0 mt-0.5" />
                  <span>Hadiah Langsung Smart Door Lock</span>
                </div>
              </div>

              <!-- Main Action Buttons -->
              <div class="space-y-3.5">
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full flex items-center justify-center py-4 px-6 bg-[#0E3B2E] hover:bg-[#07241C] text-white font-bold text-base rounded-2xl shadow-lg hover:shadow-xl transition-all hover:scale-[1.01]"
                >
                  <PhoneCall className="w-5 h-5 mr-2.5" />
                  <span>Konsultasi WhatsApp & Survei</span>
                </a>

                <a
                  href="/#kontak"
                  class="w-full flex items-center justify-center py-3.5 px-6 bg-emerald-50 hover:bg-emerald-100 text-[#0E3B2E] border border-emerald-200 font-bold text-base rounded-2xl transition-colors"
                >
                  <MessageSquare className="w-5 h-5 mr-2.5" />
                  <span>Tinggalkan Pesan di Form</span>
                </a>
              </div>

              <div class="mt-6 pt-4 border-t border-gray-100 text-center">
                <p class="text-xs sm:text-sm text-gray-500 font-medium">
                  Respon cepat 24/7 • Tanpa biaya konsultasi & perantara
                </p>
              </div>
            </div>

            <!-- Other Types Teaser Card -->
            <div class="bg-white rounded-3xl p-6 sm:p-7 border border-gray-100 shadow-sm">
              <h4 class="font-bold text-[#17201C] text-xl mb-4 font-serif">Pilihan Tipe Rumah Lainnya</h4>
              <div class="space-y-3">
                {otherTypes.map((item) => (
                  <a
                    href={`/tipe-rumah/${item.slug}`}
                    class="flex items-center gap-4 p-3 rounded-2xl hover:bg-emerald-50/60 border border-transparent hover:border-emerald-100 transition-all group"
                  >
                    <img
                      src={item.foto_url}
                      alt={item.nama_tipe}
                      class="w-18 h-18 rounded-xl object-cover shrink-0 shadow-sm"
                    />
                    <div class="flex-grow min-w-0">
                      <p class="text-base font-bold text-[#17201C] group-hover:text-[#0E3B2E] transition-colors truncate">
                        {item.nama_tipe}
                      </p>
                      <p class="text-sm font-bold text-[#0E3B2E] mt-0.5">
                        {formatRupiah(item.harga)}
                      </p>
                      <p class="text-xs sm:text-sm text-[#595959] mt-0.5 font-medium">
                        LB: {item.ukuran_bangunan} m² • LT: {item.ukuran_tanah} m²
                      </p>
                    </div>
                    <ChevronRight className="w-5 h-5 text-gray-400 group-hover:text-[#0E3B2E] shrink-0 transition-transform group-hover:translate-x-1" />
                  </a>
                ))}
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

  <FloatingWhatsApp client:load />
  <ChatbotWidget client:load />
</MainLayout>
